    "Small actions, done today, are how dreamers are made." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأفعال الصغيرة اليوم هي ما يصنع الحالمين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Taten von heute machen die Träumer von morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pequeñas acciones de hoy son las que forman a los soñadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petites actions d'aujourd'hui font les rêveurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le piccole azioni di oggi formano i sognatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
