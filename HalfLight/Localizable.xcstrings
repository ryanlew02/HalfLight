        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noite, defina a intenção e, ao acordar, escreva uma linha mesmo que seja \"nada ainda\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
