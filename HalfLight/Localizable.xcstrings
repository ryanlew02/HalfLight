    "Becoming lucid inside a recent dream, doing a reality check" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تصبح واعيًا داخل حلم حديث، وتجري فحص واقع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem kürzlichen Traum luzid werden und einen Realitätscheck machen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volverte lúcido dentro de un sueño reciente, haciendo una comprobación de realidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devenir lucide dans un rêve récent, en faisant un test de réalité"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diventare lucido dentro un sogno recente, facendo un controllo di realtà"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の夢の中で明晰になり、リアリティチェックをする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근의 꿈 속에서 자각하며, 리얼리티 체크를 하기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucide worden in een recente droom, terwijl je een realiteitscheck doet"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficar lúcido dentro de um sonho recente, fazendo uma checagem de realidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стать осознанным внутри недавнего сна, делая проверку реальности"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最近的梦中变清醒，并做一次现实检验"
          }
        }
      }
    },
    "Becoming lucid is half the battle — staying is the other half" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تصبح واعيًا نصف المعركة — والبقاء هو النصف الآخر"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luzid zu werden ist die halbe Miete – das Bleiben ist die andere Hälfte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volverte lúcido es la mitad de la batalla; quedarte es la otra mitad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devenir lucide est la moitié du combat — y rester est l'autre moitié"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diventare lucidi è metà della battaglia — restarci è l'altra metà"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明晰になるのは戦いの半分——とどまることが残りの半分"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자각하게 되는 것은 절반의 싸움 — 머무는 것이 나머지 절반"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucide worden is het halve werk — blijven is de andere helft"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficar lúcido é metade da batalha — permanecer é a outra metade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стать осознанным — половина дела, остаться — вторая половина"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "变清醒只是一半的较量——留下来才是另一半"
          }
        }
      }
    },
    "before it fades — %lld logged today" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن يتلاشى — %lld مُدوَّن اليوم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bevor er verblasst – heute %lld notiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "antes de que se desvanezca — %lld registrados hoy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "avant qu'il ne s'efface — %lld notés aujourd'hui"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "prima che svanisca — %lld registrati oggi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消えてしまう前に — 今日%lld件記録"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사라지기 전에 — 오늘 %lld개 기록함"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "voordat hij vervaagt — %lld vandaag genoteerd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "antes que ele desapareça — %lld registrados hoje"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "пока он не угас — сегодня записано: %lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁它消散前 — 今天已记录 %lld 个"
          }
        }
      }
    },
    "Belief is the engine of dream flight — doubt is the only thing that grounds you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيمان هو محرّك الطيران الحلمي — الشك هو الشيء الوحيد الذي يُبقيك على الأرض."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glaube ist der Motor des Traumflugs – Zweifel ist das Einzige, was dich erdet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La creencia es el motor del vuelo onírico: la duda es lo único que te ancla al suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La croyance est le moteur du vol onirique — le doute est la seule chose qui vous cloue au sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fede è il motore del volo onirico — il dubbio è l'unica cosa che ti tiene a terra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信念こそが夢の飛行のエンジン——疑いだけが、あなたを地に縛ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "믿음이 꿈 비행의 엔진입니다 — 의심만이 당신을 땅에 붙들어 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geloof is de motor van de droomvlucht — twijfel is het enige wat je aan de grond houdt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A crença é o motor do voo onírico — a dúvida é a única coisa que te prende ao chão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вера — двигатель полёта во сне; сомнение — единственное, что держит вас на земле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信念是梦中飞行的引擎——怀疑，才是唯一把你按在地上的东西。"
          }
        }
      }
    },
