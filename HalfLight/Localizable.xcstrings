        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気づきの瞬間をリハーサルすることが、実際にそれを起こすよう心を鍛えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알아차리는 순간을 연습하는 것이, 실제로 그 순간을 갖도록 마음을 단련합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het moment van besef oefenen traint je geest om het echt te beleven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensaiar o momento da percepção treina sua mente para realmente tê-lo."
          }
