    "System follows your device's appearance setting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el ajuste de apariencia de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit le réglage d'apparence de votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Darstellungseinstellung deines Geräts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema” segue l'impostazione dell'aspetto del tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema” segue a configuração de aparência do seu dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Systeem” volgt de weergave-instelling van je apparaat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системная» следует настройке оформления устройства."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」はデバイスの外観設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“시스템”은 기기의 화면 모드 설정을 따릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统”将跟随你设备的外观设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع «النظام» إعداد المظهر في جهازك."
          }
        }
      }
    },
