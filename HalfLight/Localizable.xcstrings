    "Back up your dreams to the cloud and keep them synced across your devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respalda tus sueños en la nube y mantenlos sincronizados en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez vos rêves dans le cloud et gardez-les synchronisés sur tous vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere deine Träume in der Cloud und halte sie auf all deinen Geräten synchron."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il backup dei tuoi sogni nel cloud e mantienili sincronizzati su tutti i dispositivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça backup dos seus sonhos na nuvem e mantenha-os sincronizados em todos os seus dispositivos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een back-up van je dromen in de cloud en houd ze gesynchroniseerd op al je apparaten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте сны в облаке и синхронизируйте их между устройствами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢をクラウドにバックアップし、すべてのデバイスで同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈을 클라우드에 백업하고 모든 기기에서 동기화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的梦境备份到云端，并在所有设备间保持同步。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ أحلامك احتياطيًا إلى السحابة وحافظ على مزامنتها عبر أجهزتك."
          }
        }
      }
    },
