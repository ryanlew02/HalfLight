          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door een deur lopen terwijl je je bestemming verwacht"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atravessar uma porta esperando o seu destino"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройти в дверь, ожидая свой пункт назначения"
