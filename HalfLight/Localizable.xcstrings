          }
        }
      }
    },
    "Tonight, set the intention and, on waking, write one line even if it's \"nothing yet.\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الليلة، اضبط النية، وعند الاستيقاظ اكتب سطرًا واحدًا حتى لو كان \"لا شيء بعد\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz heute Nacht die Absicht und schreib beim Aufwachen eine Zeile, selbst wenn es „noch nichts“ ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche, fija la intención y, al despertar, escribe una línea aunque sea \"nada todavía\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce soir, posez l'intention et, au réveil, écrivez une ligne même si c'est \"rien pour l'instant\"."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanotte, imposta l'intenzione e, al risveglio, scrivi una riga anche se è \"ancora niente\"."
          }
        },
        "ja" : {
          "stringUnit" : {
