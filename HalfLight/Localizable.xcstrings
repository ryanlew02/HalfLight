          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es heute Nacht so stark wie möglich erzwingen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzarlo il più possibile stanotte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forçar ao máximo esta noite"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vannacht zo hard mogelijk forceren"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
