    "It's a practice, not a finish line — it deepens for as long as you tend it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنها ممارسة، لا خط نهاية — تتعمّق ما دمت تعتني بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist eine Praxis, keine Ziellinie – sie vertieft sich, solange du sie pflegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una práctica, no una meta final: se profundiza mientras la cuides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
