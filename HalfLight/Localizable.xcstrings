    "What calm, screen-free thing could you do during that short wake window?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما الشيء الهادئ الخالي من الشاشات الذي يمكنك فعله خلال تلك النافذة القصيرة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Ruhiges, Bildschirmfreies könntest du in diesem kurzen Fenster tun?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué cosa tranquila y sin pantallas podrías hacer durante esa breve ventana?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle chose calme et sans écran pourriez-vous faire durant cette courte fenêtre ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa di tranquillo e senza schermi potresti fare durante quella breve finestra?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その短い窓のあいだ、画面を使わない静かなことで何ができそうですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 짧은 창 동안 화면 없이 할 수 있는 차분한 일은 무엇일까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat rustigs en schermvrij zou je tijdens dat korte venster kunnen doen?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que coisa calma e sem telas você poderia fazer durante essa breve janela?"
          }
        },
        "ru" : {
