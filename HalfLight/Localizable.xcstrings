        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 밤, 전체 조합을 한 번 실행하세요. WBTB 창, 짧은 깨어남, 그리고 다시 잠들면서 MILD."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
