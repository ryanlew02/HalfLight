        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "악몽에서 자각하게 되면, 건강한 대응은…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je lucide wordt in een nachtmerrie, is een gezonde reactie om…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você ficar lúcido em um pesadelo, uma resposta saudável é…"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы становитесь осознанным в кошмаре, здоровая реакция — это…"
