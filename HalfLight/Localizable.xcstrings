    "Force it as hard as possible tonight" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجباره بأقصى قوة الليلة"
          }
        },
        "de" : {
          "stringUnit" : {
