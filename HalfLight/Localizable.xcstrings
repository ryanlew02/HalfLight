        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 강력한 방법을 조립했습니다. 회상, 체크, MILD, 그리고 타이밍 — 모두 하룻밤에."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de krachtmethode samengesteld. Herinnering, checks, MILD en timing — allemaal in één nacht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
