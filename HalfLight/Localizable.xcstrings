    "Anchor to your dream signs especially — they're most likely to appear in dreams too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربطها بعلاماتك الحلمية خاصةً — فهي الأرجح ظهورًا في الأحلام أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veranker sie besonders an deinen Traumzeichen – die tauchen am ehesten auch in Träumen auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anclá sobre todo a tus señales de sueño: son las que más probablemente aparezcan también en los sueños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrez surtout à vos signes de rêve — ce sont eux qui ont le plus de chances d'apparaître aussi dans les rêves."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora soprattutto ai tuoi segni onirici: sono quelli che più probabilmente compaiono anche nei sogni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とくにドリームサインに錨を結びましょう——それらは夢にも最も現れやすいからです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특히 드림 사인에 닻을 거세요 — 그것들이 꿈에도 나타날 가능성이 가장 큽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anker vooral aan je droomtekens — die verschijnen het meest waarschijnlijk ook in dromen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancore sobretudo aos seus sinais de sonho — são os que têm mais chance de aparecer também nos sonhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привязывайтесь особенно к своим знакам сна — именно они вероятнее всего появятся и в снах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尤其要锚定在你的梦境征兆上——它们最有可能也出现在梦里。"
          }
        }
      }
    },
