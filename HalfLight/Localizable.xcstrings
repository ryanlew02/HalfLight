    "Revisit any lesson anytime. Even masters return to the foundations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُد إلى أي درس في أي وقت. حتى الأساتذة يعودون إلى الأساسيات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehr jederzeit zu jeder Lektion zurück. Selbst Meister kehren zu den Grundlagen zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a cualquier lección cuando quieras. Hasta los maestros regresan a los fundamentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez à n'importe quelle leçon à tout moment. Même les maîtres reviennent aux fondations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna a qualsiasi lezione in qualunque momento. Anche i maestri tornano alle basi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの教えにも、いつでも戻れます。達人でさえ、基本に立ち返るのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 수업이든 언제든 다시 찾아보세요. 대가들조차 기초로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keer wanneer dan ook terug naar elke les. Zelfs meesters keren terug naar de basis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisite qualquer lição quando quiser. Até os mestres voltam aos fundamentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращайтесь к любому уроку в любое время. Даже мастера возвращаются к основам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何一课，随时都可重温。即便是高手，也会回到基础。"
          }
        }
      }
    },
    "Revive a fading dream, sometimes shifting the scene" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحيي حلمًا متلاشيًا، وأحيانًا يبدّل المشهد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen verblassenden Traum wiederbeleben, manchmal die Szene wechseln"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revivir un sueño que se desvanece, a veces cambiando la escena"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raviver un rêve qui s'estompe, parfois en changeant de scène"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rianimare un sogno che svanisce, a volte cambiando scena"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄れゆく夢をよみがえらせ、ときに場面を切り替える"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐려지는 꿈을 되살리고, 때로는 장면을 바꾼다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vervagende droom doen herleven, soms de scène verschuivend"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanimar um sonho que se desvanece, às vezes mudando a cena"
          }
        },
        "ru" : {
