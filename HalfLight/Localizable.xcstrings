        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai forgiato la tua frase chiave. Parole che porterai oltre la soglia del sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは鍵となるフレーズを鍛え上げました。眠りの敷居を越えて持っていく言葉です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 열쇠가 될 문구를 벼려 냈습니다. 잠의 문턱을 넘어 지니고 갈 말입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt je sleutelzin gesmeed. Woorden die je over de drempel van de slaap meeneemt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você forjou sua frase-chave. Palavras que levará através do limiar do sono."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выковали свою ключевую фразу. Слова, которые вы пронесёте через порог сна."
          }
