        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann solltest du die Luzidpraxis auslassen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuándo deberías saltarte la práctica lúcida?"
          }
        },
        "fr" : {
          "stringUnit" : {
