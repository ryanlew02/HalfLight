    "How do you feel about staying aware as you fall asleep — curious, nervous, both?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تشعر حيال البقاء واعيًا وأنت تغفو — فضول، توتر، كلاهما؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie fühlst du dich dabei, beim Einschlafen wach zu bleiben – neugierig, nervös, beides?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo te sientes ante la idea de seguir consciente mientras te duermes: curioso, nervioso, ambas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que ressentez-vous à l'idée de rester conscient en vous endormant — curieux, nerveux, les deux ?"
