    "Sometimes your body falls asleep before your mind. It feels strange — and it's completely harmless." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحيانًا يغفو جسدك قبل عقلك. يبدو الأمر غريبًا — وهو غير ضار إطلاقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchmal schläft dein Körper vor deinem Geist ein. Es fühlt sich seltsam an – und ist völlig harmlos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A veces tu cuerpo se duerme antes que tu mente. Se siente extraño, y es del todo inofensivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parfois votre corps s'endort avant votre esprit. C'est étrange — et totalement inoffensif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A volte il corpo si addormenta prima della mente. È una sensazione strana — ed è del tutto innocua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ときに、心より先に体が眠りに落ちます。奇妙に感じられますが——まったく無害です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "때로는 마음보다 몸이 먼저 잠듭니다. 이상하게 느껴지지만 — 전혀 해롭지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soms valt je lichaam eerder in slaap dan je geest. Het voelt vreemd — en is volkomen onschadelijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às vezes o corpo adormece antes da mente. É estranho — e completamente inofensivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иногда тело засыпает раньше ума. Ощущение странное — и совершенно безвредное."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有时你的身体比心智先入睡。那感觉很奇怪——却完全无害。"
          }
        }
      }
    },
