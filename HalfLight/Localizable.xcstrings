        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何があっても毎晩"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무슨 일이 있어도 매일 밤"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke nacht, wat er ook gebeurt"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda noite, não importa o quê"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую ночь, несмотря ни на что"
