        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论如何每晚都做"
          }
        }
      }
    },
    "Everyday triggers like doorways, mirrors, or your dream signs" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفّزات يومية كالمداخل والمرايا أو علاماتك الحلمية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alltägliche Auslöser wie Türen, Spiegel oder deine Traumzeichen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disparadores cotidianos como puertas, espejos o tus señales de sueño"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des déclencheurs quotidiens comme les portes, les miroirs ou vos signes de rêve"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inneschi quotidiani come porte, specchi o i tuoi segni onirici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出入口や鏡、あるいはドリームサインのような日常のトリガー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문, 거울, 또는 당신의 드림 사인 같은 일상의 방아쇠"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alledaagse triggers zoals deuren, spiegels of je droomtekens"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatilhos do dia a dia como portas, espelhos ou seus sinais de sonho"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повседневные триггеры вроде дверей, зеркал или ваших знаков сна"
