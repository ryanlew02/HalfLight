    "Lucid time is precious. Decide what to do with it before you arrive." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقت الواعي ثمين. قرّر ماذا تفعل به قبل أن تصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luzide Zeit ist kostbar. Entscheide, was du damit tust, bevor du ankommst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo lúcido es precioso. Decide qué hacer con él antes de llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps lucide est précieux. Décidez quoi en faire avant d'arriver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo lucido è prezioso. Decidi cosa farne prima di arrivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明晰でいられる時間は貴重です。たどり着く前に、それで何をするか決めておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자각의 시간은 귀합니다. 도착하기 전에, 그 시간으로 무엇을 할지 정해 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucide tijd is kostbaar. Beslis wat je ermee doet voordat je aankomt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo lúcido é precioso. Decida o que fazer com ele antes de chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осознанное время драгоценно. Решите, что с ним делать, ещё до того, как окажетесь там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清醒的时间很宝贵。在抵达之前，先决定要拿它做什么。"
          }
        }
      }
    },
    "Lucid time is short — a clear goal focuses and enriches it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقت الواعي قصير — هدف واضح يركّزه ويُثريه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luzide Zeit ist kurz – ein klares Ziel fokussiert und bereichert sie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo lúcido es corto: una meta clara lo enfoca y enriquece"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps lucide est court — un objectif clair le focalise et l'enrichit"
