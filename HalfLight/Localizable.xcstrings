    "Use a real dream from your journal — familiarity makes the rehearsal vivid." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم حلمًا حقيقيًا من مفكّرتك — الألفة تجعل التمرين حيًّا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm einen echten Traum aus deinem Journal – Vertrautheit macht die Probe lebendig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un sueño real de tu diario: la familiaridad vuelve vívido el ensayo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un vrai rêve de votre journal — la familiarité rend la répétition vivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un sogno vero dal tuo diario: la familiarità rende viva la prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日記にある本物の夢を使いましょう——なじみがあるほどリハーサルが生き生きとします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
