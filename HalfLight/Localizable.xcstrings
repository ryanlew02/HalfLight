    "Every dreamer hits these walls — here's how to walk through" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل حالم يصطدم بهذه الجدران — وإليك كيف تعبرها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Träumer stößt an diese Wände – so gehst du hindurch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo soñador choca con estos muros; aquí tienes cómo atravesarlos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout rêveur se heurte à ces murs — voici comment les traverser"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni sognatore sbatte contro questi muri — ecco come attraversarli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんな夢見手もこれらの壁にぶつかる——その抜け方を紹介します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 몽자가 부딪치는 벽들 — 그것을 통과하는 법"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dromer loopt tegen deze muren aan — zo loop je erdoorheen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo sonhador esbarra nesses muros — veja como atravessá-los"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый сновидец упирается в эти стены — вот как пройти сквозь них"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个梦者都会撞上这些墙——这里教你如何穿过"
          }
        }
      }
    },
    "Every single night, no matter what" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ليلة مهما كان"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede einzelne Nacht, egal was"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las noches, pase lo que pase"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nuit, quoi qu'il arrive"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni singola notte, qualunque cosa accada"
