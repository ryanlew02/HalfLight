    "Deep sensory engagement sharpens and stabilizes the dream world." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانخراط الحسّي العميق يشحذ عالم الحلم ويثبّته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefer Sinneseinsatz schärft und stabilisiert die Traumwelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La implicación sensorial profunda agudiza y estabiliza el mundo del sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un engagement sensoriel profond aiguise et stabilise le monde du rêve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ingaggio sensoriale profondo affina e stabilizza il mondo onirico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い感覚の関わりが、夢の世界を研ぎ澄まし、安定させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깊은 감각적 관여가 꿈 세계를 또렷하게 하고 안정시킵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diepe zintuiglijke betrokkenheid scherpt en stabiliseert de droomwereld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O engajamento sensorial profundo aguça e estabiliza o mundo do sonho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубокое чувственное вовлечение обостряет и стабилизирует мир сна."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度的感官投入，会让梦境世界更锐利、更稳定。"
          }
        }
      }
    },
