    "Sign in to back up your dreams and sync them across devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para respaldar tus sueños y sincronizarlos entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour sauvegarder vos rêves et les synchroniser sur vos appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Träume zu sichern und geräteübergreifend zu synchronisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per eseguire il backup dei tuoi sogni e sincronizzarli tra i dispositivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para fazer backup dos seus sonhos e sincronizá-los entre dispositivos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan om je dromen te back-uppen en te synchroniseren tussen apparaten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы сохранить сны и синхронизировать их между устройствами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインして夢をバックアップし、デバイス間で同期しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하여 꿈을 백업하고 기기 간에 동기화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
