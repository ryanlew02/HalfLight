        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈 도중에 자신이 꿈꾸고 있음을 깨닫는 꿈"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个你在梦中途意识到自己在做梦的梦"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلم تُدرك في منتصفه أنك تحلم"
          }
        }
      }
    },
    "A dream you can't remember at all": {
