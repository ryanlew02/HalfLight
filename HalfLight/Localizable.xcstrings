          }
        }
      }
    },
    "Want to be somewhere else? In a dream, the doorway is wherever you decide it is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تريد أن تكون في مكان آخر؟ في الحلم، المدخل حيثما تقرّر أنه يكون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willst du woanders sein? Im Traum ist die Tür dort, wo du sie bestimmst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres estar en otro lugar? En un sueño, la puerta está donde tú decidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie d'être ailleurs ? Dans un rêve, la porte est là où vous décidez qu'elle est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi essere altrove? In un sogno, la porta è dove decidi tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこか別の場所に行きたい？夢では、戸口はあなたが決めたところにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 곳에 있고 싶나요? 꿈에서는 문이 당신이 정한 바로 그곳에 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je ergens anders zijn? In een droom is de deur waar jij beslist dat hij is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer estar em outro lugar? Num sonho, a porta fica onde você decidir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите оказаться в другом месте? Во сне дверь там, где вы решите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想去别处？在梦里，门就在你决定它在的地方。"
          }
        }
      }
    },
