    "Squint and concentrate hard" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّق بعينين ضيّقتين وركّز بشدّة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Augen zusammenkneifen und dich stark konzentrieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrecerrar los ojos y concentrarte con fuerza"
          }
        },
