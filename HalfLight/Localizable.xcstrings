    "Setting Dream Goals" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد أهداف الحلم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traumziele setzen"
          }
        },
        "es" : {
          "stringUnit" : {
