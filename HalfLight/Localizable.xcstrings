          }
        }
      }
    },
    "You remember no dreams at all. What's the move?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت لا تتذكّر أي أحلام إطلاقًا. ما الخطوة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
