          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 MILD의 비밀스러운 타이밍을 배웠습니다. 아침 가까이에서 연습하며 그것이 꽃피우는 걸 지켜보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt MILDs geheime timing geleerd. Oefen het tegen de ochtend en zie het tot bloei komen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprendeu o timing secreto do MILD. Pratique-o perto da manhã e veja-o florescer."
