        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A empolgação e a falta de ancoragem os acordam"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Волнение и отсутствие заземления будят их"
