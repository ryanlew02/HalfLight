          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойно, с любопытством и постоянством со временем"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかに、好奇心を持って、長く一貫して"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
