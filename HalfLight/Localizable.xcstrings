    "Changes apply instantly across the app. Your dreams stay in the language you wrote them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق التغييرات فورًا في جميع أنحاء التطبيق. تبقى أحلامك باللغة التي كتبتها بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden sofort in der gesamten App übernommen. Deine Träume bleiben in der Sprache, in der du sie geschrieben hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al instante en toda la app. Tus sueños permanecen en el idioma en que los escribiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements s'appliquent instantanément dans toute l'app. Vos rêves restent dans la langue dans laquelle vous les avez écrits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche vengono applicate immediatamente in tutta l'app. I tuoi sogni restano nella lingua in cui li hai scritti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はアプリ全体に即座に反映されます。あなたの夢は記録したときの言語のまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 앱 전체에 즉시 적용됩니다. 꿈 기록은 작성한 언어 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden direct in de hele app toegepast. Je dromen blijven in de taal waarin je ze hebt geschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas instantaneamente em todo o app. Seus sonhos permanecem no idioma em que você os escreveu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения применяются мгновенно во всём приложении. Ваши сны остаются на том языке, на котором вы их записали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会立即应用到整个应用。你的梦境会保留为你记录时所用的语言。"
          }
        }
      }
    },
