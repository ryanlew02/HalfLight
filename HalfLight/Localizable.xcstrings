    "Tell us what's wrong. Our team will review this comment." : {

    },
    "Tell us what's wrong. Our team will review this dream." : {
      "comment" : "A message displayed in a confirmation dialog that appears when a user reports a post.",
      "isCommentAutoGenerated" : true
    },
    "Tell yourself 'whatever happens is fine.' Removing the stakes keeps you steady." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل لنفسك \"مهما حدث فلا بأس\". إزالة الرهان يبقيك ثابتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag dir: „Was auch geschieht, ist in Ordnung.“ Den Einsatz wegzunehmen hält dich stabil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dite a ti mismo: \"pase lo que pase, está bien\". Quitar lo que está en juego te mantiene firme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-vous : \"quoi qu'il arrive, c'est bien\". Retirer l'enjeu vous garde stable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' a te stesso: \"qualunque cosa accada, va bene\". Togliere la posta in gioco ti mantiene stabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分にこう言いましょう。「何が起きても大丈夫」。賭けを取り除くことが、あなたを安定させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스스로에게 말하세요. \"무슨 일이 일어나도 괜찮아.\" 걸린 것을 치우면 흔들림이 가십니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg tegen jezelf: 'wat er ook gebeurt, het is goed.' De inzet wegnemen houdt je stabiel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga a si mesmo: \"aconteça o que acontecer, está tudo bem\". Tirar o que está em jogo te mantém firme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите себе: «что бы ни случилось — это нормально». Сняв ставки, вы остаётесь устойчивы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对自己说“无论发生什么都没关系”。把得失放下，能让你保持稳定。"
          }
        }
      }
    },
