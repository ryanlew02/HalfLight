    "Set a soft alarm for about 5 hours after you expect to fall asleep tonight." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط منبّهًا هادئًا بعد نحو 5 ساعات من توقّعك للنوم الليلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell einen sanften Wecker auf etwa 5 Stunden nach deinem erwarteten Einschlafen heute Nacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon una alarma suave para unas 5 horas después de cuando esperes dormirte esta noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez une alarme douce pour environ 5 heures après le moment où vous pensez vous endormir ce soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una sveglia tranquilla per circa 5 ore dopo il momento in cui pensi di addormentarti stanotte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜眠りにつくと思われる時刻の約5時間後に、静かなアラームをセットしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 밤 잠들 것으로 예상되는 시각에서 약 5시간 뒤로 조용한 알람을 맞추세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een zachte wekker voor ongeveer 5 uur na het moment waarop je verwacht vannacht in slaap te vallen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programe um alarme suave para cerca de 5 horas depois de quando você espera adormecer esta noite."
          }
        },
        "ru" : {
          "stringUnit" : {
