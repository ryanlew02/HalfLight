        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ついに夢だと気づく——その三秒後に目が覚める。なぜ？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마침내 꿈이라는 걸 깨닫고 — 3초 뒤에 깨어 버립니다. 왜일까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beseft eindelijk dat je droomt — en drie seconden later word je wakker. Waarom?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
