          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予期は夢を形づくり、無理強いは抵抗を生みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기대는 꿈을 빚고, 강요는 저항을 낳습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwachting vormt dromen; forceren schept weerstand."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A expectativa molda os sonhos; forçar cria resistência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидание формирует сны; принуждение создаёт сопротивление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预期塑造梦境；强求则制造抗拒。"
          }
        }
      }
    },
