        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已锻造出自己的关键短句。这些话语将随你越过睡眠的门槛。"
          }
        }
      }
    },
    "You've found the hidden trap. Knowing it is the first step to staying longer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجدت الفخ الخفي. معرفته هي الخطوة الأولى للبقاء أطول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die versteckte Falle gefunden. Sie zu kennen ist der erste Schritt, länger zu bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has encontrado la trampa oculta. Conocerla es el primer paso para quedarte más tiempo."
