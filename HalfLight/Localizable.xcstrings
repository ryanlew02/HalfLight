        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répéter le moment de la prise de conscience entraîne votre esprit à le vivre réellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provare il momento della consapevolezza allena la tua mente ad averlo davvero."
