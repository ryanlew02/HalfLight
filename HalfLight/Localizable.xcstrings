    "Calmly facing a nightmare, once lucid, can drain its fear over time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مواجهة الكابوس بهدوء، بعد الوعي، يمكن أن تستنزف خوفه بمرور الوقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
