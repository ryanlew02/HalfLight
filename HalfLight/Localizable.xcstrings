    "Let one of your %lld nights find you again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que una de tus %lld noches te encuentre de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez l'une de vos %lld nuits vous retrouver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass eine deiner %lld Nächte dich wiederfinden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che una delle tue %lld notti ti ritrovi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe uma das suas %lld noites te encontrar de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een van je %lld nachten je opnieuw vinden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть одна из ваших %lld ночей снова найдёт вас."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld の夜のひとつが、また あなたを訪れますように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 %lld개의 밤 중 하나가 다시 당신을 찾아오게 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你 %lld 个夜晚中的一个再次找到你。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع إحدى لياليك الـ%lld تجدك من جديد."
          }
        }
      }
    },
    "Letters, numbers, and underscores. This is how others will find you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras, números y guiones bajos. Así te encontrarán los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettres, chiffres et tirets bas. C'est ainsi que les autres vous trouveront."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchstaben, Zahlen und Unterstriche. So finden dich andere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettere, numeri e trattini bassi. È così che gli altri ti troveranno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras, números e sublinhados. É assim que os outros vão te encontrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Letters, cijfers en underscores. Zo vinden anderen je."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буквы, цифры и подчёркивания. Так вас найдут другие."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字、数字、アンダースコア。これで他の人があなたを見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영문자, 숫자, 밑줄. 다른 사람들이 이렇게 당신을 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字母、数字和下划线。其他人将以此找到你。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حروف وأرقام وشُرَط سفلية. هكذا سيجدك الآخرون."
          }
        }
      }
    },
