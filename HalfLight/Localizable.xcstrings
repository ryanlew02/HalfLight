    },
    "You've nailed the timing balance: awake enough to be aware, sleepy enough to return." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أتقنت توازن التوقيت: يقظ بما يكفي للوعي، ناعس بما يكفي للعودة."
