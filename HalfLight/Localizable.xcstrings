          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een echte droom uit je dagboek — vertrouwdheid maakt de repetitie levendig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um sonho real do seu diário — a familiaridade torna o ensaio vívido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите настоящий сон из своего дневника — знакомость делает репетицию живой."
