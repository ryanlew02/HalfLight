        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깨어 있음과 꿈을 잇는 다리를 배웠습니다. 다음으로, 당신의 도구를 고릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de brug tussen waken en dromen geleerd. Hierna kiezen we je gereedschap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você aprendeu a ponte entre a vigília e o sonho. A seguir, escolhemos a sua ferramenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы узнали о мосте между явью и сном. Дальше выберем ваш инструмент."
