    "before it fades — %lld logged today": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "antes de que se desvanezca — %lld registrados hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "avant qu'il ne s'efface — %lld notés aujourd'hui"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bevor er verblasst – heute %lld notiert"
          }
