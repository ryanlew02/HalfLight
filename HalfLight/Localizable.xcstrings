        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هادئ وفضولي وثابت مع الوقت"
          }
        }
      }
    },
    "Only try on weekends": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentarlo solo los fines de semana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'essayer que le week-end"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur am Wochenende versuchen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provarci solo nei weekend"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar só nos fins de semana"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in het weekend proberen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробовать только по выходным"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末だけ試す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말에만 시도하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在周末尝试"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحاولة في عطلات نهاية الأسبوع فقط"
          }
        }
      }
    },
    "You dream every night — four to six times. So why does morning feel so empty?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sueñas cada noche, de cuatro a seis veces. Entonces, ¿por qué la mañana se siente tan vacía?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous rêvez chaque nuit — quatre à six fois. Alors pourquoi le matin semble-t-il si vide ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du träumst jede Nacht – vier- bis sechsmal. Warum fühlt sich der Morgen dann so leer an?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sogni ogni notte, dalle quattro alle sei volte. Allora perché il mattino sembra così vuoto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sonha toda noite — de quatro a seis vezes. Então por que a manhã parece tão vazia?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je droomt elke nacht — vier tot zes keer. Waarom voelt de ochtend dan zo leeg?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты видишь сны каждую ночь — от четырёх до шести раз. Так почему же утро кажется таким пустым?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは毎晩、4〜6回も夢を見ています。それなのに、なぜ朝はこんなに空っぽに感じるのでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 매일 밤 네다섯 번에서 여섯 번 꿈을 꿉니다. 그런데 왜 아침은 이토록 텅 빈 느낌일까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你每晚都会做梦——四到六次。那为什么早晨却感觉如此空白？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تحلم كل ليلة — من أربع إلى ست مرات. فلماذا يبدو الصباح فارغًا إلى هذا الحد؟"
          }
        }
      }
    },
    "The first 60 seconds after waking decide whether a dream survives the day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros 60 segundos tras despertar deciden si un sueño sobrevive el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 60 premières secondes après le réveil décident si un rêve survit à la journée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten 60 Sekunden nach dem Aufwachen entscheiden, ob ein Traum den Tag überlebt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I primi 60 secondi dopo il risveglio decidono se un sogno sopravvive alla giornata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os primeiros 60 segundos após acordar decidem se um sonho sobrevive ao dia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste 60 seconden na het ontwaken bepalen of een droom de dag overleeft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые 60 секунд после пробуждения решают, переживёт ли сон этот день."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚めてからの最初の60秒が、その夢が一日を生き延びるかどうかを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어난 뒤 첫 60초가 그 꿈이 하루를 살아남을지 결정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来后的头 60 秒，决定一个梦能否撑过这一天。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أول 60 ثانية بعد الاستيقاظ تحدّد ما إذا كان الحلم سينجو خلال اليوم."
          }
        }
      }
    },
    "\\\"I only remember a feeling.\\\" Good — that feeling is a thread you can pull.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Solo recuerdo una sensación». Bien: esa sensación es un hilo del que puedes tirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Je ne me souviens que d'une sensation. » Bien — cette sensation est un fil que vous pouvez tirer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ich erinnere mich nur an ein Gefühl.“ Gut – dieses Gefühl ist ein Faden, an dem du ziehen kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ricordo solo una sensazione». Bene: quella sensazione è un filo che puoi tirare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Só lembro de uma sensação.” Ótimo — essa sensação é um fio do qual você pode puxar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ik herinner me alleen een gevoel.” Mooi — dat gevoel is een draad waaraan je kunt trekken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Я помню только чувство». Хорошо — это чувство и есть нить, за которую можно потянуть."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「感覚しか覚えていない」。それでいいのです——その感覚は、たぐり寄せられる糸です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“느낌 하나만 기억나요.” 좋습니다 — 그 느낌이 바로 당겨낼 수 있는 실마리입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“我只记得一种感觉。”很好——那种感觉就是一根你可以拉动的线。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«لا أتذكر سوى شعور». جيد — هذا الشعور خيط يمكنك أن تجذبه."
          }
        }
      }
    },
    "Most people delete their dreams in the first three seconds — by moving too fast.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría borra sus sueños en los primeros tres segundos, por moverse demasiado rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des gens effacent leurs rêves dans les trois premières secondes — en bougeant trop vite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten löschen ihre Träume in den ersten drei Sekunden – weil sie sich zu schnell bewegen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi tutti cancellano i propri sogni nei primi tre secondi, muovendosi troppo in fretta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria apaga seus sonhos nos primeiros três segundos — por se mexer rápido demais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste mensen wissen hun dromen in de eerste drie seconden — door te snel te bewegen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство стирает свои сны в первые три секунды — потому что слишком резко двигается."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの人は、動くのが速すぎて、最初の3秒で夢を消してしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분은 너무 빨리 움직이는 바람에 첫 3초 안에 꿈을 지워 버립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数人在最初三秒里就把梦删除了——因为动得太快。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معظم الناس يمحون أحلامهم في الثواني الثلاث الأولى — بسبب الحركة السريعة."
          }
        }
      }
    },
    "Your dreams repeat themselves. Those patterns are secret alarms that say: you're dreaming.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sueños se repiten. Esos patrones son alarmas secretas que dicen: estás soñando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos rêves se répètent. Ces schémas sont des alarmes secrètes qui disent : vous rêvez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Träume wiederholen sich. Diese Muster sind geheime Alarme, die sagen: Du träumst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi sogni si ripetono. Quegli schemi sono allarmi segreti che dicono: stai sognando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus sonhos se repetem. Esses padrões são alarmes secretos que dizem: você está sonhando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dromen herhalen zich. Die patronen zijn geheime alarmen die zeggen: je droomt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои сны повторяются. Эти закономерности — тайные сигналы, которые говорят: ты спишь."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢は繰り返されます。そのパターンは、「いま夢を見ている」と告げる秘密の警報です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 꿈은 반복됩니다. 그 패턴들은 “지금 꿈꾸고 있다”고 알려주는 비밀 알람입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的梦会重复。那些模式是悄悄发出的警报，在说：你正在做梦。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحلامك تكرّر نفسها. تلك الأنماط أجراس إنذار سرّية تقول: أنت تحلم."
          }
        }
      }
    },
    "The brain barely saves dreams to long-term memory; they fade within minutes of waking unless you catch them. This isn't a flaw you're stuck with — recall is a muscle. People who decide to remember their dreams start remembering far more within days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cerebro apenas guarda los sueños en la memoria a largo plazo; se desvanecen a los pocos minutos de despertar si no los atrapas. No es un defecto con el que estés condenado a vivir: el recuerdo es un músculo. Quienes deciden recordar sus sueños empiezan a recordar muchos más en cuestión de días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cerveau enregistre à peine les rêves dans la mémoire à long terme ; ils s'effacent en quelques minutes après le réveil si vous ne les saisissez pas. Ce n'est pas un défaut figé — la mémoire des rêves est un muscle. Ceux qui décident de se souvenir de leurs rêves s'en souviennent bien plus en quelques jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gehirn speichert Träume kaum im Langzeitgedächtnis; sie verblassen binnen Minuten nach dem Aufwachen, wenn du sie nicht festhältst. Das ist kein Makel, mit dem du feststeckst – Erinnerung ist ein Muskel. Wer beschließt, sich an seine Träume zu erinnern, erinnert sich schon nach Tagen an weit mehr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cervello salva a malapena i sogni nella memoria a lungo termine; svaniscono pochi minuti dopo il risveglio se non li catturi. Non è un difetto a cui sei condannato: il richiamo è un muscolo. Chi decide di ricordare i propri sogni inizia a ricordarne molti di più nel giro di giorni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cérebro mal salva os sonhos na memória de longo prazo; eles somem em minutos após acordar se você não os capturar. Isso não é um defeito permanente — a memória de sonhos é um músculo. Quem decide lembrar dos sonhos passa a lembrar muito mais em poucos dias."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het brein slaat dromen nauwelijks op in het langetermijngeheugen; ze vervagen binnen minuten na het ontwaken tenzij je ze vangt. Dit is geen gebrek waar je aan vastzit — herinnering is een spier. Wie besluit zijn dromen te onthouden, onthoudt er binnen dagen veel meer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мозг почти не сохраняет сны в долговременную память; они тают через считаные минуты после пробуждения, если их не уловить. Это не врождённый изъян — память на сны как мышца. Те, кто решает запоминать сны, уже через несколько дней помнят гораздо больше."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脳は夢をほとんど長期記憶に保存しません。捕まえなければ、目覚めて数分で消えてしまいます。これは一生付き合う欠点ではなく——想起は鍛えられる筋肉です。夢を覚えようと決めた人は、数日でずっと多く思い出すようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뇌는 꿈을 장기 기억에 거의 저장하지 않습니다. 붙잡지 않으면 깨어난 지 몇 분 만에 사라집니다. 이는 평생 안고 가야 할 결함이 아니라 — 회상은 근육입니다. 꿈을 기억하기로 마음먹은 사람들은 며칠 만에 훨씬 더 많이 기억하기 시작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大脑几乎不会把梦存入长期记忆；若不及时捕捉，梦会在醒来几分钟内消散。这并不是你无法摆脱的缺陷——回忆是一块肌肉。决心记住梦的人，几天之内就能记得多得多。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالكاد يحفظ الدماغ الأحلام في الذاكرة طويلة المدى؛ فهي تتلاشى خلال دقائق من الاستيقاظ ما لم تلتقطها. هذا ليس عيبًا عالقًا فيك — فالتذكّر عضلة. من يقرّر تذكّر أحلامه يبدأ بتذكّر أكثر بكثير خلال أيام."
          }
        }
      }
    },
    "Keep something to write with right where you wake. The instant you stir, record whatever you have — words, images, a single feeling. Don't judge it, don't wait. Writing it down tells your brain dreams matter, and recall snowballs from there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten algo para escribir justo donde despiertas. En cuanto te muevas, anota lo que tengas: palabras, imágenes, una sola sensación. No lo juzgues, no esperes. Escribirlo le dice a tu cerebro que los sueños importan, y desde ahí el recuerdo crece como una bola de nieve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez de quoi écrire là où vous vous réveillez. Dès que vous bougez, notez ce que vous avez — des mots, des images, une simple sensation. Ne jugez pas, n'attendez pas. L'écrire dit à votre cerveau que les rêves comptent, et la mémoire s'amplifie à partir de là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte etwas zum Schreiben direkt dort bereit, wo du aufwachst. Sobald du dich regst, halte fest, was du hast – Worte, Bilder, ein einziges Gefühl. Bewerte es nicht, warte nicht. Es aufzuschreiben sagt deinem Gehirn, dass Träume wichtig sind, und die Erinnerung wächst von da an lawinenartig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni qualcosa per scrivere proprio dove ti svegli. Appena ti muovi, annota ciò che hai — parole, immagini, una singola sensazione. Non giudicare, non aspettare. Scriverlo dice al cervello che i sogni contano, e da lì il richiamo cresce a valanga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha algo para escrever bem onde você acorda. No instante em que se mexer, registre o que tiver — palavras, imagens, uma única sensação. Não julgue, não espere. Anotar diz ao seu cérebro que os sonhos importam, e a memória cresce como bola de neve a partir daí."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd iets om mee te schrijven precies daar waar je wakker wordt. Zodra je je verroert, noteer wat je hebt — woorden, beelden, één gevoel. Oordeel niet, wacht niet. Het opschrijven vertelt je brein dat dromen ertoe doen, en vanaf daar groeit de herinnering als een sneeuwbal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи чем писать прямо там, где просыпаешься. Как только шевельнёшься, запиши всё, что есть — слова, образы, одно чувство. Не оценивай, не жди. Записанное говорит мозгу, что сны важны, и память дальше нарастает как снежный ком."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚める場所のすぐそばに、書くものを置いておきましょう。身じろぎした瞬間に、あるものを記録します——言葉、イメージ、たった一つの感覚でも。評価せず、ためらわずに。書き留めることが脳に「夢は大切だ」と伝え、そこから想起は雪だるま式に増えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어나는 바로 그 자리에 적을 것을 두세요. 몸을 뒤척이는 순간, 가진 것을 무엇이든 기록하세요 — 단어, 이미지, 단 하나의 느낌이라도. 판단하지도, 기다리지도 마세요. 적어 두는 행위가 뇌에 꿈이 중요하다고 알려주고, 거기서부터 회상은 눈덩이처럼 불어납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你醒来的地方就放好纸笔。一动身，就把所有记得的记录下来——词语、画面、哪怕只是一种感觉。别评判，别等待。把它写下来，等于告诉大脑梦很重要，记忆便会由此滚雪球般增长。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بما تكتب به في المكان الذي تستيقظ فيه تمامًا. ما إن تتحرك، دوّن ما لديك — كلمات أو صور أو شعور واحد. لا تحكم عليه ولا تنتظر. تدوينه يخبر دماغك أن الأحلام مهمة، ومن هناك يتراكم التذكّر ككرة الثلج."
          }
        }
      }
    },
    "Recall rarely arrives whole. You'll get a mood, a color, a face, a place. Write the fragment first, then gently ask: what came before this? Often one detail unspools several more. Never dismiss a scrap as too small.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuerdo rara vez llega entero. Tendrás un estado de ánimo, un color, un rostro, un lugar. Escribe primero el fragmento y luego pregúntate con suavidad: ¿qué vino antes de esto? A menudo un detalle desenrolla varios más. Nunca descartes un retazo por pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire arrive rarement entière. Vous aurez une ambiance, une couleur, un visage, un lieu. Notez d'abord le fragment, puis demandez-vous doucement : qu'y avait-il avant ? Souvent un détail en déroule plusieurs autres. Ne rejetez jamais un fragment parce qu'il est trop petit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung kommt selten ganz. Du bekommst eine Stimmung, eine Farbe, ein Gesicht, einen Ort. Schreib zuerst das Fragment auf und frag dann sanft: Was kam davor? Oft rollt ein Detail mehrere weitere auf. Verwirf nie einen Fetzen als zu klein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ricordo arriva di rado intero. Avrai un'atmosfera, un colore, un volto, un luogo. Scrivi prima il frammento, poi chiediti con calma: cosa è venuto prima di questo? Spesso un dettaglio ne srotola molti altri. Non scartare mai un brandello perché troppo piccolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória raramente chega inteira. Você terá um clima, uma cor, um rosto, um lugar. Escreva o fragmento primeiro e então pergunte com calma: o que veio antes disto? Muitas vezes um detalhe desenrola vários outros. Nunca descarte um retalho por ser pequeno demais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnering komt zelden compleet. Je krijgt een sfeer, een kleur, een gezicht, een plek. Schrijf eerst het fragment op en vraag dan rustig: wat kwam hiervoor? Vaak rolt één detail er meerdere uit. Verwerp nooit een flard als te klein."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспоминание редко приходит целиком. Тебе достанется настроение, цвет, лицо, место. Сначала запиши фрагмент, затем мягко спроси: что было до этого? Часто одна деталь разматывает ещё несколько. Никогда не отмахивайся от обрывка как от слишком мелкого."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想起は丸ごとやってくることはめったにありません。気分、色、顔、場所——そんな断片です。まず断片を書き、それから静かに問いましょう。「この前には何があった？」。たいてい、一つの細部が次々と他を引き出します。小さすぎるからと、かけらを切り捨ててはいけません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회상은 통째로 오는 일이 드뭅니다. 분위기, 색, 얼굴, 장소가 떠오를 겁니다. 먼저 그 조각을 적고, 그런 다음 부드럽게 물어보세요: 이 앞에는 무엇이 있었지? 종종 하나의 디테일이 여러 개를 풀어냅니다. 너무 사소하다고 조각을 결코 버리지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回忆很少完整地到来。你会得到一种情绪、一种颜色、一张脸、一个地方。先写下这个碎片，然后温和地问：在这之前是什么？往往一个细节会牵出好几个。永远别因为太小而丢弃任何一丝碎片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نادرًا ما يأتي التذكّر كاملًا. ستحصل على مزاج أو لون أو وجه أو مكان. اكتب الشظية أولًا، ثم اسأل بلطف: ماذا سبق هذا؟ غالبًا ما تفكّ تفصيلة واحدة عدة تفاصيل أخرى. لا تستبعد قصاصة أبدًا لأنها صغيرة جدًا."
          }
        }
      }
    },
    "When you wake, stay still with your eyes closed for a moment. Don't jump up, don't grab your phone. Let the dream linger in that half-light. Replaying it once or twice in your mind before moving makes it far more likely to survive.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando despiertes, quédate quieto con los ojos cerrados un momento. No te levantes de golpe, no cojas el teléfono. Deja que el sueño permanezca en esa penumbra. Repasarlo una o dos veces en tu mente antes de moverte lo hace mucho más probable de sobrevivir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au réveil, restez immobile, les yeux fermés, un instant. Ne bondissez pas, n'attrapez pas votre téléphone. Laissez le rêve s'attarder dans cette pénombre. Le revivre une ou deux fois dans votre esprit avant de bouger augmente nettement ses chances de survivre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du aufwachst, bleib einen Moment mit geschlossenen Augen still liegen. Spring nicht auf, greif nicht zum Handy. Lass den Traum in diesem Halbdunkel nachklingen. Ihn ein- oder zweimal im Kopf abzuspielen, bevor du dich bewegst, lässt ihn viel eher überleben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti svegli, resta immobile con gli occhi chiusi per un momento. Non saltare su, non afferrare il telefono. Lascia che il sogno indugi in quella penombra. Riviverlo una o due volte nella mente prima di muoverti lo rende molto più probabile da conservare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao acordar, fique imóvel com os olhos fechados por um momento. Não pule da cama, não pegue o celular. Deixe o sonho permanecer naquela penumbra. Revivê-lo uma ou duas vezes na mente antes de se mexer torna muito mais provável que ele sobreviva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je wakker wordt, blijf even stil liggen met je ogen dicht. Spring niet op, pak je telefoon niet. Laat de droom in dat halflicht nazinderen. Hem een of twee keer in gedachten herhalen voordat je beweegt, maakt de kans veel groter dat hij blijft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проснувшись, на миг замри с закрытыми глазами. Не вскакивай, не хватайся за телефон. Дай сну побыть в этом полумраке. Прокрутить его раз-другой в голове, прежде чем двигаться, — и он куда вероятнее уцелеет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目が覚めたら、しばらく目を閉じたままじっとしていましょう。飛び起きたり、スマホをつかんだりしないこと。そのほの暗さの中に夢を漂わせておきます。動く前に頭の中で一、二度なぞるだけで、夢はずっと残りやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어나면 잠시 눈을 감은 채 가만히 있으세요. 벌떡 일어나지도, 휴대폰을 잡지도 마세요. 그 어스름 속에 꿈이 머물게 두세요. 움직이기 전에 마음속으로 한두 번 되짚어 보면 꿈이 살아남을 가능성이 훨씬 커집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来时，先闭着眼睛静静躺一会儿。别一跃而起，别去抓手机。让梦在那半明半暗中停留。在动身之前在脑中回放一两遍，能让它存活的可能性大得多。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تستيقظ، ابقَ ساكنًا وعيناك مغمضتان للحظة. لا تثب واقفًا ولا تمسك هاتفك. دع الحلم يتمهّل في ذلك الضوء الخافت. إعادة تشغيله مرة أو مرتين في ذهنك قبل أن تتحرك يجعله أكثر احتمالًا للبقاء بكثير."
          }
        }
      }
    },
    "Read back through your journal and you'll find recurring themes — a certain place, person, feeling, or impossible event. These are your dream signs. Learning to recognize them is huge: when one shows up, it can trigger the realization that you're dreaming.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relee tu diario y encontrarás temas recurrentes: cierto lugar, persona, sensación o evento imposible. Esas son tus señales oníricas. Aprender a reconocerlas es enorme: cuando aparece una, puede desencadenar la conciencia de que estás soñando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relisez votre journal et vous trouverez des thèmes récurrents — un certain lieu, une personne, une sensation, ou un événement impossible. Ce sont vos signes oniriques. Apprendre à les reconnaître est capital : quand l'un d'eux apparaît, il peut déclencher la prise de conscience que vous rêvez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies dein Tagebuch noch einmal durch und du findest wiederkehrende Themen – einen bestimmten Ort, eine Person, ein Gefühl oder ein unmögliches Ereignis. Das sind deine Traumzeichen. Sie erkennen zu lernen, ist enorm: Taucht eines auf, kann es die Erkenntnis auslösen, dass du träumst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileggi il tuo diario e troverai temi ricorrenti — un certo luogo, una persona, una sensazione o un evento impossibile. Sono i tuoi segnali onirici. Imparare a riconoscerli è enorme: quando ne compare uno, può innescare la consapevolezza di stare sognando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Releia seu diário e encontrará temas recorrentes — um certo lugar, pessoa, sensação ou evento impossível. Esses são seus sinais de sonho. Aprender a reconhecê-los é enorme: quando um aparece, pode disparar a percepção de que você está sonhando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees je dagboek terug en je vindt terugkerende thema's — een bepaalde plek, persoon, gevoel of onmogelijke gebeurtenis. Dit zijn je droomtekens. Ze leren herkennen is enorm: als er een opduikt, kan het het besef triggeren dat je droomt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перечитай свой дневник — и найдёшь повторяющиеся темы: определённое место, человека, чувство или невозможное событие. Это твои признаки сна. Научиться их узнавать — огромное дело: когда такой признак появляется, он может вызвать осознание того, что ты спишь."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記を読み返すと、繰り返し現れるテーマが見つかります——ある場所、人、感覚、あるいはあり得ない出来事。それがあなたの「夢のサイン」です。これを見分けられるようになるのは大きな一歩。サインが現れたとき、それが「夢を見ている」という気づきの引き金になり得ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기를 다시 읽어 보면 반복되는 주제가 보입니다 — 특정한 장소, 사람, 느낌, 혹은 일어날 수 없는 사건. 이것이 당신의 꿈 신호입니다. 이를 알아보는 법을 익히는 것은 대단히 중요합니다: 신호가 나타날 때, 그것이 “지금 꿈꾸고 있다”는 깨달음을 촉발할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读你的日记，你会发现反复出现的主题——某个地方、某个人、某种感觉，或某件不可能的事。这些就是你的梦境征兆。学会识别它们意义重大：当其中之一出现时，它能触发“我在做梦”的觉悟。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد قراءة يومياتك وستجد مواضيع متكررة — مكان معيّن أو شخص أو شعور أو حدث مستحيل. هذه هي إشارات حلمك. تعلّم التعرّف عليها أمر هائل: حين تظهر إحداها، قد تشعل إدراكك أنك تحلم."
          }
        }
      }
    },
    "When did you last remember a dream? What was the feeling it left behind?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo recordaste un sueño por última vez? ¿Qué sensación te dejó?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes-vous souvenu d'un rêve pour la dernière fois ? Quelle sensation a-t-il laissée ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann hast du dich zuletzt an einen Traum erinnert? Welches Gefühl hat er hinterlassen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand'è stata l'ultima volta che hai ricordato un sogno? Che sensazione ti ha lasciato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando foi a última vez que você lembrou de um sonho? Que sensação ele deixou?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer herinnerde je je voor het laatst een droom? Welk gevoel liet hij achter?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ты в последний раз помнил сон? Какое чувство он оставил?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に夢を覚えていたのはいつですか？ そのとき、どんな感覚が残りましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 꿈을 기억한 건 언제인가요? 그 꿈이 남긴 느낌은 무엇이었나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你上一次记得一个梦是什么时候？它留下了什么感觉？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى تذكرت حلمًا آخر مرة؟ وما الشعور الذي تركه؟"
          }
        }
      }
    },
    "What gets in the way of writing first thing — your phone, getting up, rushing? How could you remove it?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te impide escribir nada más despertar: el teléfono, levantarte, las prisas? ¿Cómo podrías eliminarlo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui vous empêche d'écrire dès le réveil — votre téléphone, vous lever, la précipitation ? Comment pourriez-vous l'éliminer ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hält dich davon ab, als Erstes zu schreiben – dein Handy, das Aufstehen, die Hektik? Wie könntest du es beseitigen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa ti impedisce di scrivere appena sveglio — il telefono, alzarti, la fretta? Come potresti eliminarlo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que atrapalha escrever logo ao acordar — o celular, levantar, a pressa? Como você poderia eliminar isso?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat staat het schrijven meteen na het ontwaken in de weg — je telefoon, opstaan, haast? Hoe zou je dat kunnen wegnemen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что мешает писать сразу после пробуждения — телефон, подъём, спешка? Как это можно убрать?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚めてすぐ書くのを邪魔するものは何ですか——スマホ、起き上がること、焦り？ それをどう取り除けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어나자마자 적는 것을 방해하는 건 무엇인가요 — 휴대폰, 일어나기, 서두름? 그걸 어떻게 없앨 수 있을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是什么妨碍你一醒来就记录——手机、起床、匆忙？你能如何排除它？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يعيق الكتابة فور الاستيقاظ — هاتفك، النهوض، العجلة؟ وكيف يمكنك إزالته؟"
          }
        }
      }
    },
    "What's the smallest dream detail you've ever remembered? Could you have pulled more from it?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es el detalle de un sueño más pequeño que has recordado? ¿Podrías haber sacado más de él?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est le plus petit détail de rêve dont vous vous souveniez ? Auriez-vous pu en tirer davantage ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist das kleinste Traumdetail, an das du dich je erinnert hast? Hättest du mehr daraus ziehen können?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è il dettaglio di un sogno più piccolo che hai mai ricordato? Avresti potuto trarne di più?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é o menor detalhe de sonho que você já lembrou? Você poderia ter tirado mais dele?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is het kleinste droomdetail dat je ooit hebt onthouden? Had je er meer uit kunnen halen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая самая маленькая деталь сна тебе когда-либо запоминалась? Мог бы ты вытянуть из неё больше?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまで覚えていた中で、いちばん小さな夢の細部は何ですか？ そこからもっと引き出せたかもしれませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 기억한 가장 작은 꿈의 디테일은 무엇인가요? 거기서 더 많이 끌어낼 수 있었을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你记得过的最小的梦境细节是什么？你本可以从中挖出更多吗？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أصغر تفصيلة حلم تذكرتها يومًا؟ هل كان بإمكانك استخلاص المزيد منها؟"
          }
        }
      }
    },
    "What's the first thing you usually do when you wake? Is it helping or erasing your dreams?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es lo primero que sueles hacer al despertar? ¿Ayuda o borra tus sueños?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est la première chose que vous faites d'habitude au réveil ? Aide-t-elle vos rêves ou les efface-t-elle ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was tust du normalerweise als Erstes nach dem Aufwachen? Hilft es deinen Träumen oder löscht es sie?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è la prima cosa che fai di solito al risveglio? Aiuta o cancella i tuoi sogni?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é a primeira coisa que você costuma fazer ao acordar? Isso ajuda ou apaga seus sonhos?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is het eerste dat je meestal doet als je wakker wordt? Helpt het je dromen of wist het ze?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что ты обычно делаешь первым делом после пробуждения? Это помогает снам или стирает их?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚めてまずすることは、たいてい何ですか？ それは夢を助けていますか、それとも消していますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어나서 보통 가장 먼저 하는 일은 무엇인가요? 그것이 꿈을 돕고 있나요, 아니면 지우고 있나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你醒来后通常做的第一件事是什么？它在帮助还是抹去你的梦？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أول شيء تفعله عادةً عند الاستيقاظ؟ هل يساعد أحلامك أم يمحوها؟"
          }
        }
      }
    },
    "Looking back, what shows up again and again in your dreams?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirando atrás, ¿qué aparece una y otra vez en tus sueños?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le recul, qu'est-ce qui revient encore et encore dans vos rêves ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was taucht rückblickend immer wieder in deinen Träumen auf?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando indietro, cosa compare di continuo nei tuoi sogni?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhando para trás, o que aparece repetidamente em seus sonhos?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat duikt, terugkijkend, telkens weer op in je dromen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оглянуться, что снова и снова появляется в твоих снах?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り返ってみて、あなたの夢に何度も現れるものは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌이켜 보면, 당신의 꿈에 거듭 나타나는 것은 무엇인가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回想一下，什么在你的梦里一再出现？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالنظر إلى الوراء، ما الذي يظهر مرارًا وتكرارًا في أحلامك؟"
          }
        }
      }
    },
    "Tonight, as you fall asleep, repeat: \\\"I will remember my dreams.\\\" Intention primes recall.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta noche, al quedarte dormido, repite: «Recordaré mis sueños». La intención prepara el recuerdo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette nuit, en vous endormant, répétez : « Je me souviendrai de mes rêves. » L'intention amorce la mémoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole heute Nacht beim Einschlafen: „Ich werde mich an meine Träume erinnern.“ Absicht bahnt die Erinnerung an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanotte, mentre ti addormenti, ripeti: «Ricorderò i miei sogni». L'intenzione prepara il richiamo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta noite, ao adormecer, repita: “Vou lembrar dos meus sonhos.” A intenção prepara a memória."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal vannacht terwijl je in slaap valt: “Ik zal mijn dromen onthouden.” Intentie bereidt de herinnering voor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня, засыпая, повторяй: «Я запомню свои сны». Намерение настраивает память."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜、眠りに落ちながら繰り返しましょう。「私は夢を覚えている」。意図が想起の準備を整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 잠들면서 되뇌세요: “나는 내 꿈을 기억할 것이다.” 의도가 회상을 준비시킵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚入睡时，重复：“我会记住我的梦。”意图会为回忆做好准备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الليلة، وأنت تغفو، كرّر: «سأتذكّر أحلامي». النية تهيّئ التذكّر."
          }
        }
      }
    },
    "Log your very next dream in HalfLight the moment you wake — even if it's one word.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu próximo sueño en HalfLight en cuanto despiertes, aunque sea una sola palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez votre tout prochain rêve dans HalfLight dès le réveil — même si ce n'est qu'un mot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deinen allernächsten Traum in HalfLight fest, sobald du aufwachst – und sei es nur ein Wort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il tuo prossimo sogno in HalfLight appena ti svegli — anche se è una sola parola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu próximo sonho no HalfLight assim que acordar — mesmo que seja uma palavra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg je allereerste volgende droom vast in HalfLight zodra je wakker wordt — al is het één woord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запиши свой следующий сон в HalfLight сразу после пробуждения — пусть даже одно слово."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目が覚めた瞬間、次に見る夢をHalfLightに記録しましょう——たとえ一語でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 꾸는 꿈을 깨어나는 즉시 HalfLight에 기록하세요 — 단 한 단어라도."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来的那一刻，就把你接下来的那个梦记进 HalfLight——哪怕只有一个词。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل حلمك التالي مباشرةً في HalfLight لحظة استيقاظك — ولو كان كلمة واحدة."
          }
        }
      }
    },
    "Next waking, lie still and name one detail before reaching for anything. Then write it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima vez que despiertes, quédate quieto y nombra un detalle antes de coger nada. Luego escríbelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au prochain réveil, restez immobile et nommez un détail avant de toucher quoi que ce soit. Puis notez-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Aufwachen bleib still liegen und benenne ein Detail, bevor du nach irgendetwas greifst. Dann schreib es auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al prossimo risveglio resta immobile e nomina un dettaglio prima di prendere qualsiasi cosa. Poi scrivilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No próximo despertar, fique imóvel e nomeie um detalhe antes de pegar qualquer coisa. Depois escreva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf bij het volgende ontwaken stil liggen en benoem één detail voordat je naar iets grijpt. Schrijf het dan op."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В следующий раз, проснувшись, лежи неподвижно и назови одну деталь, прежде чем что-либо хватать. Потом запиши её."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に目覚めたら、何にも手を伸ばす前にじっと横たわり、細部を一つ口にしましょう。それから書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 깨어나면 무언가에 손을 뻗기 전에 가만히 누워 디테일 하나를 말해 보세요. 그런 다음 적으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次醒来时，先静静躺着，在伸手去拿任何东西之前说出一个细节。然后把它写下来。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الاستيقاظ القادم، استلقِ ساكنًا وسمِّ تفصيلة واحدة قبل أن تمدّ يدك إلى أي شيء. ثم اكتبها."
          }
        }
      }
    },
    "Tomorrow, don't move for 30 seconds after waking. Just replay the night, then write.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mañana, no te muevas durante 30 segundos tras despertar. Solo repasa la noche y luego escribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demain, ne bougez pas pendant 30 secondes après le réveil. Revivez simplement la nuit, puis écrivez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweg dich morgen nach dem Aufwachen 30 Sekunden lang nicht. Spiel einfach die Nacht noch einmal ab, dann schreib."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domani, non muoverti per 30 secondi dopo il risveglio. Rivivi solo la notte, poi scrivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amanhã, não se mexa por 30 segundos depois de acordar. Apenas reviva a noite e então escreva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg morgen 30 seconden niet na het ontwaken. Speel gewoon de nacht opnieuw af, schrijf dan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завтра не двигайся 30 секунд после пробуждения. Просто прокрути ночь в голове, потом запиши."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日は、目覚めてから30秒間動かないでください。ただ夜を再生し、それから書きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일은 깨어난 뒤 30초 동안 움직이지 마세요. 그저 간밤을 되감아 본 다음 적으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天，醒来后 30 秒不要动。只是回放整夜，然后再写。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غدًا، لا تتحرك لمدة 30 ثانية بعد الاستيقاظ. أعد تشغيل الليلة في ذهنك فقط، ثم اكتب."
          }
        }
      }
    },
    "Review your journal entries and mark one recurring dream sign to watch for.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las entradas de tu diario y marca una señal onírica recurrente que vigilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez en revue les entrées de votre journal et repérez un signe onirique récurrent à surveiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deine Tagebucheinträge durch und markiere ein wiederkehrendes Traumzeichen, auf das du achten willst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi le voci del tuo diario e segna un segnale onirico ricorrente da tenere d'occhio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as entradas do seu diário e marque um sinal de sonho recorrente para observar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je dagboeknotities en markeer één terugkerend droomteken om op te letten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотри записи дневника и отметь один повторяющийся признак сна, за которым будешь следить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記の記録を見直し、注目すべき繰り返しの夢のサインを一つ印づけましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기 기록을 살펴보고 주의 깊게 지켜볼 반복되는 꿈 신호 하나를 표시하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回顾你的日记条目，标记一个值得留意的反复出现的梦境征兆。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع تدويناتك وحدّد إشارة حلم متكررة واحدة لتنتبه لها."
          }
        }
      }
    },
    "You've learned the first secret: dreams aren't gone, just uncaught. Tomorrow, you start catching them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has aprendido el primer secreto: los sueños no se han ido, solo no los has atrapado. Mañana empiezas a atraparlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez appris le premier secret : les rêves ne sont pas perdus, juste non saisis. Demain, vous commencez à les attraper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast das erste Geheimnis gelernt: Träume sind nicht weg, nur nicht eingefangen. Morgen fängst du an, sie zu fangen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai imparato il primo segreto: i sogni non sono spariti, solo non catturati. Domani inizi a catturarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você aprendeu o primeiro segredo: os sonhos não se foram, só não foram capturados. Amanhã você começa a capturá-los."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt het eerste geheim geleerd: dromen zijn niet weg, alleen niet gevangen. Morgen begin je ze te vangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты узнал первый секрет: сны не исчезли, их просто не уловили. Завтра ты начнёшь их ловить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の秘密を学びました——夢は消えたのではなく、捕まえていないだけ。明日から、あなたはそれを捕まえ始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 비밀을 배웠습니다: 꿈은 사라진 게 아니라 붙잡지 못했을 뿐입니다. 내일부터 당신은 그것을 붙잡기 시작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你学到了第一个秘密：梦并没有消失，只是没被捕捉。明天，你就开始捕捉它们。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلّمت السرّ الأول: الأحلام لم تختفِ، بل لم تُلتقَط فقط. غدًا، تبدأ في التقاطها."
          }
        }
      }
    },
    "Your dream journal is open. Every entry sharpens the next morning's memory.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu diario de sueños está abierto. Cada entrada agudiza la memoria de la mañana siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal de rêves est ouvert. Chaque entrée affûte la mémoire du lendemain matin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Traumtagebuch ist eröffnet. Jeder Eintrag schärft die Erinnerung am nächsten Morgen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo diario dei sogni è aperto. Ogni voce affina la memoria del mattino dopo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu diário de sonhos está aberto. Cada entrada aguça a memória da manhã seguinte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je droomdagboek is geopend. Elke notitie scherpt het geheugen van de volgende ochtend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой дневник снов открыт. Каждая запись обостряет память на следующее утро."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの夢日記が開かれました。一つひとつの記録が、翌朝の記憶を研ぎ澄まします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 꿈 일기가 열렸습니다. 기록 하나하나가 다음 날 아침의 기억을 더 또렷하게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的梦境日记已经开启。每一条记录都会让第二天清晨的记忆更敏锐。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يومياتك للأحلام مفتوحة الآن. كل تدوينة تشحذ ذاكرة صباح الغد."
          }
        }
      }
    },
    "You're learning to fish in the fog. Fragments today become full dreams tomorrow.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás aprendiendo a pescar en la niebla. Los fragmentos de hoy se vuelven sueños completos mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous apprenez à pêcher dans le brouillard. Les fragments d'aujourd'hui deviennent des rêves complets demain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lernst, im Nebel zu fischen. Fragmente von heute werden morgen zu ganzen Träumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai imparando a pescare nella nebbia. I frammenti di oggi diventano sogni interi domani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está aprendendo a pescar na névoa. Os fragmentos de hoje viram sonhos inteiros amanhã."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je leert vissen in de mist. Fragmenten van vandaag worden morgen hele dromen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты учишься рыбачить в тумане. Сегодняшние обрывки завтра станут целыми снами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは霧の中で釣りをする術を学んでいます。今日の断片は、明日には完全な夢になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 안개 속에서 낚는 법을 배우고 있습니다. 오늘의 조각이 내일은 온전한 꿈이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在学习在雾中垂钓。今天的碎片，明天会成为完整的梦。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تتعلّم الصيد في الضباب. شظايا اليوم تصبح أحلامًا كاملة غدًا."
          }
        }
      }
    },
    "You've learned the gentlest, most powerful recall trick there is: stillness.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has aprendido el truco de recuerdo más suave y poderoso que existe: la quietud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez appris l'astuce de mémorisation la plus douce et la plus puissante qui soit : l'immobilité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den sanftesten, wirkungsvollsten Erinnerungstrick gelernt, den es gibt: Stille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai imparato il trucco di richiamo più delicato e potente che esista: l'immobilità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você aprendeu o truque de memória mais suave e poderoso que existe: a quietude."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de zachtste, krachtigste herinneringstruc geleerd die er is: stilte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты освоил самый мягкий и мощный приём для памяти: неподвижность."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっとも穏やかで、もっとも強力な想起のコツを学びました——静けさです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 부드럽고 가장 강력한 회상 비결을 배웠습니다: 가만히 있기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你学会了最温柔、最有力的回忆技巧：静止不动。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلّمت ألطف وأقوى حيلة للتذكّر على الإطلاق: السكون."
          }
        }
      }
    },
    "Recall mastered. You're catching dreams and reading their patterns — the raw material of lucidity.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerdo dominado. Estás atrapando sueños y leyendo sus patrones: la materia prima de la lucidez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisation maîtrisée. Vous attrapez vos rêves et lisez leurs schémas — la matière première de la lucidité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung gemeistert. Du fängst Träume ein und liest ihre Muster – den Rohstoff der Luzidität."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiamo padroneggiato. Stai catturando i sogni e leggendone gli schemi: la materia prima della lucidità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória dominada. Você está capturando sonhos e lendo seus padrões — a matéria-prima da lucidez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnering onder de knie. Je vangt dromen en leest hun patronen — de grondstof van luciditeit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память освоена. Ты ловишь сны и читаешь их закономерности — сырьё осознанности."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想起をマスターしました。あなたは夢を捕まえ、そのパターンを読み解いています——明晰さの原材料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회상을 익혔습니다. 당신은 꿈을 붙잡고 그 패턴을 읽고 있습니다 — 자각의 원재료입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回忆已掌握。你正在捕捉梦境、解读它们的模式——这是清醒的原材料。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتقنت التذكّر. أنت تلتقط الأحلام وتقرأ أنماطها — المادة الخام للوعي."
          }
        }
      }
    },
    "Recall is the foundation of everything. No technique works without it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuerdo es la base de todo. Ninguna técnica funciona sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire est le fondement de tout. Aucune technique ne marche sans elle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung ist die Grundlage von allem. Keine Technik funktioniert ohne sie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il richiamo è la base di tutto. Nessuna tecnica funziona senza di esso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória é a base de tudo. Nenhuma técnica funciona sem ela."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnering is de basis van alles. Geen enkele techniek werkt zonder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память — основа всего. Без неё не работает ни одна техника."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想起はすべての土台です。それなしでは、どんな技法も機能しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회상은 모든 것의 토대입니다. 그것 없이는 어떤 기법도 통하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回忆是一切的基础。没有它，任何技巧都不起作用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكّر أساس كل شيء. لا تنجح أي تقنية بدونه."
          }
        }
      }
    },
    "Even \\\"I remember nothing\\\" counts — write that. It keeps the habit alive.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso «no recuerdo nada» cuenta: escríbelo. Mantiene vivo el hábito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même « je ne me souviens de rien » compte — notez-le. Cela garde l'habitude en vie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst „Ich erinnere mich an nichts“ zählt – schreib das auf. Es hält die Gewohnheit am Leben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche «non ricordo nulla» conta: scrivilo. Mantiene viva l'abitudine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até “não lembro de nada” conta — escreva isso. Mantém o hábito vivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs “ik herinner me niets” telt — schrijf dat op. Het houdt de gewoonte in leven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже «я ничего не помню» считается — запиши это. Так привычка остаётся живой."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「何も覚えていない」でもカウントされます——それを書きましょう。習慣が生き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“아무것도 기억나지 않음”도 셈에 듭니다 — 그렇게 적으세요. 습관이 살아 있게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪怕是“什么都不记得”也算——把它写下来。它能让习惯保持鲜活。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى «لا أتذكر شيئًا» تُحتسَب — اكتب ذلك. فهو يُبقي العادة حيّة."
          }
        }
      }
    },
    "Stay in the dream's posture — sometimes returning to how you were lying brings it back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la postura del sueño: a veces volver a cómo estabas tumbado lo trae de vuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez dans la posture du rêve — parfois, reprendre la position dans laquelle vous étiez le ramène."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib in der Haltung des Traums – manchmal bringt es ihn zurück, wenn du dich wieder so hinlegst, wie du lagst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta nella posizione del sogno: a volte tornare a come eri sdraiato lo fa riaffiorare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a postura do sonho — às vezes voltar à posição em que você estava deitado o traz de volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf in de houding van de droom — soms haalt teruggaan naar hoe je lag hem terug."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохрани позу, в которой видел сон — иногда вернуться к тому, как ты лежал, помогает его вернуть."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢を見ていたときの姿勢のままで——横たわっていた姿勢に戻ると、夢が戻ってくることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈을 꾸던 자세를 유지하세요 — 누워 있던 자세로 돌아가면 꿈이 되살아나기도 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持做梦时的姿势——有时回到你原本躺着的姿态，梦就会回来。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابقَ على وضعية الحلم — أحيانًا تعيدك العودة إلى الوضع الذي كنت مستلقيًا عليه إلى الحلم."
          }
        }
      }
    },
    "Set a calm alarm tone — jarring alarms blast dreams out of memory.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un tono de alarma suave: las alarmas estridentes expulsan los sueños de la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une sonnerie de réveil douce — les alarmes stridentes chassent les rêves de la mémoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell einen ruhigen Weckton ein – schrille Wecker sprengen Träume aus dem Gedächtnis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un suono di sveglia tranquillo: le sveglie stridenti spazzano via i sogni dalla memoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um toque de alarme calmo — alarmes estridentes expulsam os sonhos da memória."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een rustige wektoon in — schelle wekkers blazen dromen uit je geheugen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставь спокойный сигнал будильника — резкие будильники выбивают сны из памяти."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかなアラーム音に設定しましょう——耳障りなアラームは、夢を記憶から吹き飛ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차분한 알람 소리를 설정하세요 — 요란한 알람은 꿈을 기억에서 날려 버립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把闹钟设成柔和的铃声——刺耳的闹钟会把梦从记忆里炸飞。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط نغمة منبّه هادئة — المنبّهات الصاخبة تطرد الأحلام من الذاكرة."
          }
        }
      }
    },
    "When a dream sign appears in waking life too, do a reality check. That bridge is gold.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una señal onírica aparezca también en la vida despierta, haz una comprobación de realidad. Ese puente vale oro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un signe onirique apparaît aussi dans la vie éveillée, faites un test de réalité. Ce pont vaut de l'or."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Traumzeichen auch im Wachleben auftaucht, mach einen Realitätscheck. Diese Brücke ist Gold wert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un segnale onirico appare anche nella vita da sveglio, fai una verifica della realtà. Quel ponte vale oro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um sinal de sonho aparecer também na vida desperta, faça um teste de realidade. Essa ponte vale ouro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een droomteken ook in je wakkere leven opduikt, doe dan een realiteitscheck. Die brug is goud waard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда признак сна появляется и наяву, сделай проверку реальности. Этот мост — на вес золота."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢のサインが現実の生活でも現れたら、現実確認をしましょう。その橋渡しは金に値します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈 신호가 깨어 있는 삶에서도 나타나면 현실 점검을 하세요. 그 다리가 곧 금입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当梦境征兆也出现在清醒生活中时，做一次现实检验。那座桥梁价值连城。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تظهر إشارة حلم في حياة اليقظة أيضًا، أجرِ فحص واقع. ذلك الجسر ثمين كالذهب."
          }
        }
      }
    },
    "Dreams fade fast because the brain chemistry that stores long-term memories is largely switched off during REM. The memory isn't deleted — it was barely written down in the first place, so catching it quickly is everything.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sueños se desvanecen rápido porque la química cerebral que almacena recuerdos a largo plazo está en gran parte apagada durante el REM. El recuerdo no se borra: apenas se escribió desde el principio, así que atraparlo rápido lo es todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rêves s'effacent vite parce que la chimie cérébrale qui stocke les souvenirs à long terme est largement éteinte pendant le sommeil paradoxal. Le souvenir n'est pas effacé — il a à peine été inscrit au départ, alors le saisir vite, c'est tout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Träume verblassen schnell, weil die Hirnchemie, die Langzeiterinnerungen speichert, im REM-Schlaf weitgehend abgeschaltet ist. Die Erinnerung wird nicht gelöscht – sie wurde von vornherein kaum festgehalten, deshalb ist schnelles Festhalten alles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sogni svaniscono in fretta perché la chimica cerebrale che archivia i ricordi a lungo termine è in gran parte spenta durante il REM. Il ricordo non viene cancellato: semplicemente è stato a malapena registrato all'inizio, perciò catturarlo in fretta è tutto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sonhos somem rápido porque a química cerebral que guarda memórias de longo prazo fica em grande parte desligada durante o REM. A memória não é apagada — ela mal foi registrada para começar, então capturá-la rápido é tudo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dromen vervagen snel omdat de hersenchemie die langetermijnherinneringen opslaat tijdens de REM-slaap grotendeels is uitgeschakeld. De herinnering wordt niet gewist — ze werd om te beginnen nauwelijks opgeschreven, dus snel vangen is alles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сны быстро тают, потому что химия мозга, отвечающая за хранение долговременных воспоминаний, в фазе REM в основном выключена. Воспоминание не стирается — оно изначально едва записано, поэтому быстро его уловить — это всё."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢が早く消えるのは、長期記憶を蓄える脳内の化学物質が、レム睡眠中はおおむねオフになっているからです。記憶は消されるのではなく——そもそもほとんど書き込まれていないのです。だからこそ、素早く捕まえることがすべてです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈이 빨리 사라지는 이유는 장기 기억을 저장하는 뇌의 화학 작용이 렘수면 동안 대부분 꺼져 있기 때문입니다. 기억이 삭제되는 게 아니라 — 애초에 거의 기록되지 않았기 때문에, 빨리 붙잡는 것이 전부입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "梦消散得快，是因为储存长期记忆的大脑化学机制在 REM 期间基本处于关闭状态。记忆并没有被删除——它本来就几乎没被写下来，所以迅速捕捉就是一切。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلاشى الأحلام بسرعة لأن كيمياء الدماغ التي تخزّن الذكريات طويلة المدى تكون مُعطَّلة إلى حد كبير أثناء نوم REM. الذاكرة لا تُحذَف — بل بالكاد دُوّنت أصلًا، لذا فإن التقاطها بسرعة هو كل شيء."
          }
        }
      }
    },
    "Keeping a dream journal is one of the few habits shown in research to reliably increase both how much you recall and how often you become lucid. The simple act of writing tells your brain that dreams are worth keeping.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevar un diario de sueños es uno de los pocos hábitos que la investigación demuestra que aumenta de forma fiable tanto cuánto recuerdas como con qué frecuencia te vuelves lúcido. El simple acto de escribir le dice a tu cerebro que vale la pena conservar los sueños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir un journal de rêves est l'une des rares habitudes dont la recherche montre qu'elle augmente de façon fiable à la fois ce dont vous vous souvenez et la fréquence de vos rêves lucides. Le simple fait d'écrire dit à votre cerveau que les rêves valent la peine d'être gardés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Traumtagebuch zu führen ist eine der wenigen Gewohnheiten, die laut Forschung zuverlässig sowohl steigern, wie viel du dich erinnerst, als auch wie oft du luzid wirst. Das bloße Schreiben sagt deinem Gehirn, dass Träume es wert sind, behalten zu werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere un diario dei sogni è una delle poche abitudini che la ricerca mostra aumentare in modo affidabile sia quanto ricordi sia quanto spesso diventi lucido. Il semplice atto di scrivere dice al cervello che i sogni vale la pena conservarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter um diário de sonhos é um dos poucos hábitos que a pesquisa mostra aumentar de forma confiável tanto o quanto você lembra quanto a frequência com que fica lúcido. O simples ato de escrever diz ao seu cérebro que os sonhos valem a pena guardar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een droomdagboek bijhouden is een van de weinige gewoonten waarvan onderzoek aantoont dat ze zowel hoeveel je je herinnert als hoe vaak je lucide wordt betrouwbaar verhoogt. De simpele daad van schrijven vertelt je brein dat dromen het bewaren waard zijn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведение дневника снов — одна из немногих привычек, которая, по данным исследований, надёжно повышает и то, сколько ты помнишь, и то, как часто становишься осознанным. Сам акт записи говорит мозгу, что сны стоит сохранять."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢日記をつけることは、想起の量と明晰になる頻度の両方を確実に高めると研究で示された数少ない習慣の一つです。書くという単純な行為が、脳に「夢は残す価値がある」と伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈 일기를 쓰는 것은, 회상량과 자각 빈도를 모두 신뢰할 수 있게 높여 준다고 연구에서 밝혀진 몇 안 되는 습관 중 하나입니다. 적는다는 단순한 행위가 뇌에 꿈은 간직할 가치가 있다고 알려줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记梦境日记是少数被研究证实能可靠提升你回忆量和清醒频率的习惯之一。仅仅写下来这个动作，就在告诉大脑：梦值得保留。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بيوميات للأحلام من العادات القليلة التي أظهر البحث أنها تزيد بشكل موثوق من مقدار ما تتذكره ومن تكرار وعيك في الحلم. مجرد فعل الكتابة يخبر دماغك أن الأحلام تستحق الاحتفاظ بها."
          }
        }
      }
    },
    "Memory works by association, so a single fragment is a real handle: re-feeling the dream's mood or picturing its one clear image often cues the surrounding scene back into view, like pulling a thread.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria funciona por asociación, así que un solo fragmento es un asidero real: volver a sentir el estado de ánimo del sueño o visualizar su única imagen clara a menudo trae de vuelta la escena que lo rodea, como tirar de un hilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire fonctionne par association, donc un seul fragment est une vraie prise : ressentir à nouveau l'ambiance du rêve ou se représenter sa seule image nette ramène souvent la scène environnante, comme on tire un fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedächtnis funktioniert über Assoziation, daher ist ein einzelnes Fragment ein echter Griff: die Stimmung des Traums erneut zu fühlen oder sein eines klares Bild vor sich zu sehen, ruft oft die umgebende Szene zurück – wie wenn man an einem Faden zieht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria funziona per associazione, quindi un singolo frammento è un vero appiglio: risentire l'atmosfera del sogno o immaginarne l'unica immagine nitida spesso richiama in vista la scena circostante, come tirare un filo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória funciona por associação, então um único fragmento é uma alça de verdade: voltar a sentir o clima do sonho ou imaginar sua única imagem nítida muitas vezes traz de volta a cena ao redor, como puxar um fio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheugen werkt via associatie, dus één fragment is een echt handvat: de sfeer van de droom opnieuw voelen of het ene heldere beeld voor je zien haalt vaak de omringende scène terug, alsof je aan een draad trekt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память работает по ассоциациям, поэтому один фрагмент — настоящая зацепка: заново ощутить настроение сна или представить его единственный чёткий образ часто возвращает в поле зрения окружающую сцену, словно тянешь за нить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶は連想で働くので、たった一つの断片が本物の取っ手になります。夢の気分をもう一度感じたり、はっきりした一つのイメージを思い描いたりすると、まるで糸を引くように、周囲の場面が視界に戻ってくることがよくあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억은 연상으로 작동하므로 단 하나의 조각이 진짜 손잡이가 됩니다: 꿈의 분위기를 다시 느끼거나 선명한 이미지 하나를 떠올리면, 실을 당기듯 주변 장면이 다시 떠오르는 일이 많습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆靠联想运作，所以单个碎片就是一个真正的把手：重新感受梦的情绪，或在脑中浮现那一个清晰的画面，往往会像拉线一样把周围的场景重新唤回。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الذاكرة بالترابط، لذا فإن شظية واحدة مقبض حقيقي: إعادة الشعور بمزاج الحلم أو تخيّل صورته الواضحة الوحيدة كثيرًا ما يستدعي المشهد المحيط إلى الذهن، كأنك تجذب خيطًا."
          }
        }
      }
    },
    "Waking gently keeps you near the dream state long enough to copy it into memory. A jarring alarm floods you with alertness and stress hormones that scatter the dream before you can catch it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despertar con suavidad te mantiene cerca del estado de sueño el tiempo suficiente para copiarlo en la memoria. Una alarma estridente te inunda de alerta y hormonas del estrés que dispersan el sueño antes de que puedas atraparlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se réveiller en douceur vous maintient près de l'état de rêve assez longtemps pour le copier en mémoire. Une alarme stridente vous inonde de vigilance et d'hormones de stress qui dispersent le rêve avant que vous puissiez le saisir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanftes Aufwachen hält dich lange genug nahe am Traumzustand, um ihn ins Gedächtnis zu kopieren. Ein schriller Wecker überflutet dich mit Wachheit und Stresshormonen, die den Traum zerstreuen, bevor du ihn fassen kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svegliarsi dolcemente ti tiene vicino allo stato di sogno abbastanza a lungo da copiarlo nella memoria. Una sveglia stridente ti inonda di allerta e ormoni dello stress che disperdono il sogno prima che tu possa catturarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordar suavemente mantém você perto do estado de sonho tempo suficiente para copiá-lo na memória. Um alarme estridente te inunda de alerta e hormônios do estresse que dispersam o sonho antes que você consiga capturá-lo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacht ontwaken houdt je lang genoeg bij de droomtoestand om die in je geheugen te kopiëren. Een schelle wekker overspoelt je met alertheid en stresshormonen die de droom verstrooien voordat je hem kunt vangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкое пробуждение удерживает тебя у состояния сна достаточно долго, чтобы скопировать его в память. Резкий будильник захлёстывает бодростью и гормонами стресса, которые рассеивают сон прежде, чем ты успеешь его уловить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしく目覚めると、夢の状態の近くに十分とどまり、それを記憶に写し取れます。耳障りなアラームは、覚醒とストレスホルモンであなたを満たし、捕まえる前に夢を散らしてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드럽게 깨어나면 꿈 상태 가까이에 충분히 머물러 그것을 기억에 옮겨 적을 수 있습니다. 요란한 알람은 각성과 스트레스 호르몬으로 당신을 뒤덮어, 붙잡기도 전에 꿈을 흩어 버립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和地醒来，会让你在梦境状态附近停留得够久，足以把它抄进记忆。刺耳的闹钟则用警觉和压力荷尔蒙将你淹没，在你来得及捕捉之前就把梦冲散。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستيقاظ بلطف يبقيك قريبًا من حالة الحلم وقتًا كافيًا لنسخه إلى الذاكرة. أما المنبّه الصاخب فيغمرك باليقظة وهرمونات التوتر التي تبدّد الحلم قبل أن تتمكّن من التقاطه."
          }
        }
      }
    },
    "Dream signs are personal — one dreamer's recurring theme might be losing teeth, another's a childhood house. Cataloguing your own is one of the most powerful, individualized routes to lucidity there is.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las señales oníricas son personales: el tema recurrente de un soñador puede ser perder los dientes; el de otro, la casa de la infancia. Catalogar las tuyas es una de las rutas más poderosas e individualizadas hacia la lucidez que existen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signes oniriques sont personnels — le thème récurrent d'un rêveur peut être de perdre ses dents, celui d'un autre une maison d'enfance. Cataloguer les vôtres est l'une des voies les plus puissantes et personnalisées vers la lucidité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traumzeichen sind persönlich – bei dem einen Träumer sind es ausfallende Zähne, beim anderen das Elternhaus der Kindheit. Die eigenen zu katalogisieren ist einer der wirkungsvollsten, individuellsten Wege zur Luzidität, die es gibt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnali onirici sono personali: per un sognatore il tema ricorrente può essere perdere i denti, per un altro la casa d'infanzia. Catalogare i tuoi è una delle vie più potenti e personalizzate verso la lucidità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinais de sonho são pessoais — o tema recorrente de um sonhador pode ser perder os dentes; o de outro, a casa da infância. Catalogar os seus é uma das rotas mais poderosas e individualizadas para a lucidez que existem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Droomtekens zijn persoonlijk — bij de ene dromer is het terugkerende thema tanden verliezen, bij de andere een huis uit de kindertijd. Je eigen tekens catalogiseren is een van de krachtigste, meest persoonlijke routes naar luciditeit die er is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Признаки сна индивидуальны — у одного сновидца повторяющаяся тема — выпадающие зубы, у другого — дом детства. Составить каталог своих — один из самых мощных и персональных путей к осознанности."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢のサインは人それぞれです——ある人は歯が抜けること、別の人は子ども時代の家が繰り返しのテーマかもしれません。自分のサインを目録にすることは、明晰さに至るもっとも強力で個別化された道の一つです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈 신호는 개인적입니다 — 어떤 사람의 반복 주제는 이가 빠지는 것이고, 다른 사람은 어린 시절의 집일 수 있습니다. 자신의 신호를 정리해 두는 것은 자각으로 가는 가장 강력하고 개인화된 길 중 하나입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "梦境征兆因人而异——一个梦者反复出现的主题可能是掉牙，另一个则是童年的房子。把自己的征兆编成目录，是通往清醒最有力、最个性化的途径之一。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشارات الحلم شخصية — قد يكون الموضوع المتكرر لحالم ما هو تساقط الأسنان، ولآخر بيت الطفولة. فهرسة إشاراتك الخاصة من أقوى الطرق الفردية إلى الوعي على الإطلاق."
          }
        }
      }
    },
    "Why don't most people remember their dreams?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué la mayoría no recuerda sus sueños?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi la plupart des gens ne se souviennent-ils pas de leurs rêves ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum erinnern sich die meisten Menschen nicht an ihre Träume?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché la maggior parte delle persone non ricorda i propri sogni?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que a maioria não lembra dos seus sonhos?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom herinneren de meeste mensen zich hun dromen niet?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему большинство людей не помнят свои сны?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜほとんどの人は夢を覚えていないのでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 대부분의 사람들은 자신의 꿈을 기억하지 못할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么大多数人记不住自己的梦？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا لا يتذكر معظم الناس أحلامهم؟"
          }
        }
      }
    },
    "When should you record a dream?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo deberías registrar un sueño?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand devriez-vous noter un rêve ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann solltest du einen Traum festhalten?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dovresti registrare un sogno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você deve registrar um sonho?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer moet je een droom vastleggen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда следует записывать сон?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢はいつ記録すべきですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈은 언제 기록해야 할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你应该在什么时候记录一个梦？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى ينبغي أن تسجّل حلمًا؟"
          }
        }
      }
    },
    "You wake with only a vague feeling. What do you do?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despiertas solo con una sensación vaga. ¿Qué haces?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous réveillez avec seulement une vague sensation. Que faites-vous ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wachst nur mit einem vagen Gefühl auf. Was tust du?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti svegli con solo una vaga sensazione. Cosa fai?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acorda apenas com uma sensação vaga. O que faz?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt wakker met alleen een vaag gevoel. Wat doe je?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты просыпаешься лишь со смутным чувством. Что делаешь?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼんやりした感覚だけで目が覚めました。どうしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막연한 느낌만 안고 깨어났습니다. 어떻게 하시겠어요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你醒来时只剩下一种模糊的感觉。你会怎么做？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستيقظ ولا تحمل سوى شعور غامض. ماذا تفعل؟"
          }
        }
      }
    },
    "What's the best first move on waking?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es el mejor primer movimiento al despertar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est le meilleur premier geste au réveil ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist der beste erste Schritt beim Aufwachen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è la prima mossa migliore al risveglio?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é a melhor primeira atitude ao acordar?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is de beste eerste zet bij het ontwaken?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какое лучшее первое действие после пробуждения?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚めて最初にとるべき最善の行動は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어나서 가장 좋은 첫 행동은 무엇일까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来后最好的第一步是什么？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أفضل خطوة أولى عند الاستيقاظ؟"
          }
        }
      }
    },
    "What's a \\\"dream sign\\\"?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es una «señal onírica»?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qu'un « signe onirique » ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist ein „Traumzeichen“?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cos'è un «segnale onirico»?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que é um “sinal de sonho”?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is een “droomteken”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что такое «признак сна»?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「夢のサイン」とは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“꿈 신호”란 무엇인가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是“梦境征兆”？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي «إشارة الحلم»؟"
          }
        }
      }
    },
    "Everyone dreams nightly — the memories just fade fast without effort to keep them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos sueñan cada noche; los recuerdos solo se desvanecen rápido sin esfuerzo por conservarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde rêve chaque nuit — les souvenirs s'effacent simplement vite sans effort pour les garder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder träumt jede Nacht – die Erinnerungen verblassen nur schnell, wenn man sich nicht müht, sie zu behalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti sognano ogni notte: i ricordi semplicemente svaniscono in fretta senza lo sforzo di conservarli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos sonham toda noite — as memórias só somem rápido sem esforço para mantê-las."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen droomt elke nacht — de herinneringen vervagen alleen snel zonder moeite om ze te behouden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все видят сны каждую ночь — просто воспоминания быстро тают без усилий их сохранить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰もが毎晩夢を見ています——ただ、覚えておく努力をしないと記憶が早く消えるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 매일 밤 꿈을 꿉니다 — 기억하려는 노력이 없으면 기억이 그저 빨리 사라질 뿐입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个人每晚都做梦——只是若不努力留住，记忆便消散得很快。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجميع يحلمون كل ليلة — لكن الذكريات تتلاشى بسرعة دون جهد للاحتفاظ بها."
          }
        }
      }
    },
    "Dreams evaporate fast — capture them in the first moments, every time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sueños se evaporan rápido: captúralos en los primeros instantes, siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rêves s'évaporent vite — saisissez-les dans les premiers instants, à chaque fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Träume verdampfen schnell – halte sie jedes Mal in den ersten Momenten fest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sogni evaporano in fretta: catturali nei primi istanti, ogni volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sonhos evaporam rápido — capture-os nos primeiros instantes, sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dromen verdampen snel — vang ze elke keer in de eerste momenten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сны испаряются быстро — лови их в первые мгновения, каждый раз."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢はすぐに蒸発します——毎回、最初の数瞬で捕まえましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿈은 빠르게 증발합니다 — 매번 첫 순간에 붙잡으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "梦消散得很快——每一次都要在最初的瞬间捕捉它们。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبخّر الأحلام بسرعة — التقطها في اللحظات الأولى، في كل مرة."
          }
        }
      }
    },
    "A single fragment is a thread — pulling it gently often reveals more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo fragmento es un hilo: tirar de él con suavidad suele revelar más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul fragment est un fil — le tirer doucement révèle souvent davantage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Fragment ist ein Faden – sanft daran zu ziehen offenbart oft mehr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo frammento è un filo: tirarlo con delicatezza spesso rivela di più."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único fragmento é um fio — puxá-lo com cuidado costuma revelar mais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén fragment is een draad — er zachtjes aan trekken onthult vaak meer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один фрагмент — это нить: потяни мягко, и часто откроется больше."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たった一つの断片が糸です——そっと引けば、たいていもっと多くが現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단 하나의 조각이 실마리입니다 — 부드럽게 당기면 더 많은 것이 드러나곤 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个碎片就是一根线——轻轻拉动，往往会牵出更多。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشظية الواحدة خيط — جذبها بلطف كثيرًا ما يكشف المزيد."
          }
        }
      }
    },
    "Stillness on waking keeps the dream from scattering before you can hold it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La quietud al despertar evita que el sueño se disperse antes de que puedas retenerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immobilité au réveil empêche le rêve de se disperser avant que vous puissiez le retenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille beim Aufwachen bewahrt den Traum davor, sich zu zerstreuen, bevor du ihn festhalten kannst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immobilità al risveglio impedisce al sogno di disperdersi prima che tu possa trattenerlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A quietude ao acordar impede que o sonho se disperse antes de você conseguir segurá-lo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilte bij het ontwaken voorkomt dat de droom uiteenvalt voordat je hem kunt vasthouden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижность при пробуждении не даёт сну рассеяться, прежде чем ты успеешь его удержать."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚めたときの静けさが、夢を抱きとめる前に散ってしまうのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어날 때의 고요함은 꿈을 붙들기도 전에 흩어지지 않도록 막아 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来时的静止，能让梦在你抓住它之前不至于四散。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكون عند الاستيقاظ يمنع الحلم من التبدّد قبل أن تتمكّن من الإمساك به."
          }
        }
      }
    },
    "Recognizing your personal recurring patterns is a doorway to becoming lucid.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocer tus patrones recurrentes personales es una puerta para volverte lúcido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaître vos schémas récurrents personnels est une porte vers la lucidité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine persönlichen wiederkehrenden Muster zu erkennen ist ein Tor zur Luzidität."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscere i tuoi schemi ricorrenti personali è una porta per diventare lucido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconhecer seus padrões recorrentes pessoais é uma porta para se tornar lúcido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je persoonlijke terugkerende patronen herkennen is een deur naar lucide worden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнавание своих личных повторяющихся закономерностей — дверь к осознанности."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分だけの繰り返しのパターンに気づくことが、明晰になるための入り口です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신만의 반복 패턴을 알아보는 것이 자각으로 가는 문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别你个人反复出现的模式，是通向清醒的一扇门。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعرّف على أنماطك المتكررة الشخصية بوابة إلى أن تصبح واعيًا."
          }
        }
      }
    },
    "They don't actually dream": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En realidad no sueñan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne rêvent pas vraiment"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie träumen eigentlich nicht"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In realtà non sognano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na verdade não sonham"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze dromen eigenlijk niet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они на самом деле не видят снов"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実は夢を見ていない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사실은 꿈을 꾸지 않는다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们其实不做梦"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هم في الحقيقة لا يحلمون"
          }
        }
      }
    },
    "Dreams aren't saved to memory unless you catch them quickly": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sueños no se guardan en la memoria a menos que los atrapes rápido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rêves ne sont pas enregistrés en mémoire à moins de les saisir vite"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Träume werden nicht im Gedächtnis gespeichert, wenn man sie nicht schnell festhält"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sogni non vengono salvati in memoria se non li catturi in fretta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sonhos não são salvos na memória a menos que você os capture rápido"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dromen worden niet opgeslagen tenzij je ze snel vangt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сны не сохраняются в памяти, если их быстро не уловить"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すばやく捕まえない限り、夢は記憶に保存されない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨리 붙잡지 않으면 꿈은 기억에 저장되지 않는다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你迅速捕捉，否则梦不会存入记忆"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحفَظ الأحلام في الذاكرة ما لم تلتقطها بسرعة"
          }
        }
      }
    },
    "Only some people can dream": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo algunas personas pueden soñar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules certaines personnes peuvent rêver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur manche Menschen können träumen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo alcune persone possono sognare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só algumas pessoas conseguem sonhar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maar sommige mensen kunnen dromen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сны могут видеть только некоторые люди"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢を見られるのは一部の人だけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사람만 꿈을 꿀 수 있다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有部分人能做梦"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الناس فقط يستطيعون الحلم"
          }
        }
      }
    },
    "Whenever you get around to it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tengas un momento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous en avez le temps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann immer du dazu kommst"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ci riesci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você puder"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer het je uitkomt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда руки дойдут"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が空いたときに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유가 생길 때"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你有空的时候"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى ما سنحت لك الفرصة"
          }
        }
      }
    },
    "Immediately on waking, before doing anything else": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmediatamente al despertar, antes de hacer nada más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Immédiatement au réveil, avant de faire quoi que ce soit d'autre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort beim Aufwachen, bevor du irgendetwas anderes tust"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito al risveglio, prima di fare qualsiasi altra cosa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imediatamente ao acordar, antes de fazer qualquer outra coisa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteen bij het ontwaken, voordat je iets anders doet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу после пробуждения, прежде чем делать что-либо ещё"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目覚めてすぐ、ほかの何かをする前に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어나자마자, 다른 무엇을 하기 전에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来后立刻，在做任何其他事之前"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فور الاستيقاظ، قبل أن تفعل أي شيء آخر"
          }
        }
      }
    },
    "Only if it was a good dream": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si fue un buen sueño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement si c'était un bon rêve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn es ein guter Traum war"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se è stato un bel sogno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só se foi um bom sonho"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen als het een goede droom was"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только если сон был хорошим"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "良い夢だったときだけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 꿈이었을 때만"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当它是个好梦时"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط إذا كان حلمًا جيدًا"
          }
        }
      }
    },
    "Ignore it — it's not a real dream": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorarla: no es un sueño de verdad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ignorer — ce n'est pas un vrai rêve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorieren – das ist kein echter Traum"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorarla: non è un vero sogno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar — não é um sonho de verdade"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Negeer het — het is geen echte droom"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игнорировать — это не настоящий сон"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視する——本物の夢ではない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무시한다 — 진짜 꿈이 아니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略它——那不是真正的梦"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاهله — إنه ليس حلمًا حقيقيًا"
          }
        }
      }
    },
    "Write the fragment, then let more details unspool from it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir el fragmento y luego dejar que se desplieguen más detalles a partir de él"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter le fragment, puis laisser d'autres détails s'en dérouler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fragment aufschreiben und dann weitere Details daraus entrollen lassen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivere il frammento, poi lasciare che ne srotolino altri dettagli"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever o fragmento e então deixar mais detalhes se desenrolarem dele"
