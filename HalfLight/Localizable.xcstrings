    "\"I Never Remember My Dreams\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«لا أتذكر أحلامي أبدًا»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich erinnere mich nie an meine Träume“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Nunca recuerdo mis sueños»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Je ne me souviens jamais de mes rêves »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Non ricordo mai i miei sogni”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「夢をまったく覚えていない」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“꿈이 전혀 기억나지 않아요”"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ik herinner me mijn dromen nooit”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Eu nunca lembro dos meus sonhos”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Я никогда не помню свои сны»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我从不记得我的梦”"
          }
        }
      }
    },
    "\"I only remember a feeling.\" Good — that feeling is a thread you can pull." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"لا أتذكّر سوى شعور.\" جيد — ذلك الشعور خيط يمكنك أن تجذبه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ich erinnere mich nur an ein Gefühl.\" Gut – dieses Gefühl ist ein Faden, an dem du ziehen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Solo recuerdo una sensación\". Bien: esa sensación es un hilo del que puedes tirar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Je ne me souviens que d'une sensation.\" Bien — cette sensation est un fil que vous pouvez tirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ricordo solo una sensazione.\" Bene — quella sensazione è un filo che puoi tirare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ある感じしか覚えていない。」けっこう——その感じは、たぐり寄せられる糸です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"느낌 하나밖에 기억 안 나.\" 좋습니다 — 그 느낌이 당겨 볼 수 있는 실입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ik herinner me alleen een gevoel.\" Mooi — dat gevoel is een draad waaraan je kunt trekken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Só lembro de uma sensação.\" Ótimo — essa sensação é um fio que você pode puxar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Я помню только чувство». Хорошо — это чувство и есть ниточка, за которую можно потянуть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我只记得一种感觉。”很好——那种感觉，就是你可以拉动的一根线。"
          }
        }
      }
    },
    "\"I Realize, Then Wake Up\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«أُدرك، ثم أستيقظ»"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich merke es, dann wache ich auf“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Me doy cuenta y entonces despierto»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Je réalise, puis je me réveille »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mi accorgo, poi mi sveglio”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「気づいた途端、目が覚める」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“깨닫는 순간 깨어나요”"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ik besef het, dan word ik wakker”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Eu percebo, e então acordo”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Я осознаю — и просыпаюсь»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我意识到了，然后就醒了”"
          }
        }
      }
    },
    "\"Nothing's Working\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«لا شيء ينجح»"
          }
        },
