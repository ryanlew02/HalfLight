    "You've assembled the powerhouse method. Recall, checks, MILD, and timing — all in one night." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد ركّبت الطريقة الجبّارة. الاسترجاع، والفحوص، وMILD، والتوقيت — كلها في ليلة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
