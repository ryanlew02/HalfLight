    "Streaks beat effort. One calm minute a day out-trains an hour of frustration." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستمرارية تتفوّق على الجهد. دقيقة هادئة يوميًا تدرّبك أكثر من ساعة من الإحباط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beständigkeit schlägt Anstrengung. Eine ruhige Minute am Tag trainiert besser als eine Stunde Frust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constancia gana al esfuerzo. Un minuto tranquilo al día entrena más que una hora de frustración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La régularité l'emporte sur l'effort. Une minute calme par jour vaut mieux qu'une heure de frustration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La costanza batte lo sforzo. Un minuto di calma al giorno allena più di un'ora di frustrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "継続は努力に勝ります。穏やかな1日1分は、1時間のいら立ちよりも力になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾸준함이 노력을 이깁니다. 하루 1분의 차분함이 한 시간의 좌절보다 낫습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consistentie verslaat inspanning. Eén kalme minuut per dag traint beter dan een uur frustratie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A constância vence o esforço. Um minuto calmo por dia treina mais que uma hora de frustração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постоянство важнее усилий. Одна спокойная минута в день тренирует лучше часа разочарования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坚持胜过用力。每天平静的一分钟，胜过一小时的沮丧。"
          }
        }
      }
    },
    "Strong reactions snap you awake — calm, passive attention keeps you in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردود الفعل القوية تُيقظك فجأة — الانتباه الهادئ السلبي يُبقيك في الداخل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heftige Reaktionen reißen dich wach – ruhige, passive Aufmerksamkeit hält dich drinnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reacciones fuertes te despiertan de golpe; la atención calmada y pasiva te mantiene dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réactions fortes vous réveillent brusquement — l'attention calme et passive vous garde dedans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reazioni forti ti svegliano di colpo — l'attenzione calma e passiva ti tiene dentro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強い反応はあなたを一気に覚まします——穏やかで受け身の注意が、あなたを内側にとどめます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강한 반응은 당신을 단번에 깨웁니다 — 고요하고 수동적인 주의가 당신을 안에 머물게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterke reacties rukken je wakker — kalme, passieve aandacht houdt je binnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reações fortes te acordam de repente — a atenção calma e passiva te mantém dentro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сильные реакции резко пробуждают вас — спокойное, пассивное внимание удерживает внутри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强烈的反应会把你猛地惊醒——平静、被动的注意才能让你留在里面。"
          }
        }
      }
    },
