          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجباره بأقصى قوة الليلة"
          }
        }
      }
    },
    "Calm, curious, and consistent over time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranquilo, curioso y constante con el tiempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme, curieux et régulier dans la durée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhig, neugierig und beständig über die Zeit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo, curioso e costante nel tempo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo, curioso e constante ao longo do tempo"
          }
        },
        "nl": {
          "stringUnit": {
