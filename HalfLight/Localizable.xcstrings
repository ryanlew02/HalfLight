    "7 days free, then %@/year. Cancel anytime.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "7 días gratis, luego %@/año. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 jours gratuits, puis %@/an. Annulable à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage gratis, danach %@/Jahr. Jederzeit kündbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "7 giorni gratis, poi %@/anno. Disdici quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dias grátis, depois %@/ano. Cancele quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagen gratis, daarna %@/jaar. Altijd opzegbaar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней бесплатно, затем %@/год. Отмена в любое время."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間無料、その後%@/年。いつでもキャンセル可能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 무료, 이후 연 %@. 언제든지 취소 가능."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天免费，之后 %@/年。随时可取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "7 أيام مجانًا، ثم %@/سنة. يمكنك الإلغاء في أي وقت."
          }
        }
      }
    },
