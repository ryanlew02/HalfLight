    "Tell other dreamers about yourself…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntales a otros soñadores sobre ti…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez de vous aux autres rêveurs…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl anderen Träumern von dir…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Racconta di te agli altri sognatori…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte aos outros sonhadores sobre você…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel andere dromers over jezelf…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите о себе другим мечтателям…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の夢見る人にあなたのことを教えて…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 몽상가들에게 자신을 소개하세요…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向其他梦想家介绍你自己…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرّف الحالمين الآخرين بنفسك…"
          }
        }
      }
    },
