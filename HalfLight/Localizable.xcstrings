    "Tap “Capture tonight's dream” the moment you wake — before it fades.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Captura el sueño de esta noche» en cuanto despiertes, antes de que se desvanezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Capturez le rêve de cette nuit » dès le réveil — avant qu'il ne s'efface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe direkt nach dem Aufwachen auf „Halte den Traum von heute Nacht fest“ – bevor er verblasst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca “Cattura il sogno di stanotte” appena ti svegli — prima che svanisca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Capture o sonho desta noite” assim que acordar — antes que ele desapareça."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op “Leg de droom van vannacht vast” zodra je wakker wordt — voordat hij vervaagt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Запишите сон этой ночи» сразу после пробуждения — пока он не угас."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目が覚めたらすぐ「今夜の夢を記録」をタップ — 消えてしまう前に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠에서 깨자마자 “오늘 밤의 꿈을 기록하세요”를 누르세요 — 사라지기 전에."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来后立即点击“记录今晚的梦”——趁它消散之前。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر «سجّل حلم هذه الليلة» بمجرد استيقاظك — قبل أن يتلاشى."
          }
        }
      }
    },
    "Tap to continue": {
      "localizations": {
        "es": {
