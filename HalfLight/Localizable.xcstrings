          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachst du manchmal von selbst am frühen Morgen auf? Könntest du diesen Moment nutzen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿A veces te despiertas de forma natural de madrugada? ¿Podrías aprovechar ese momento?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous arrive-t-il de vous réveiller naturellement au petit matin ? Pourriez-vous saisir ce moment ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti capita di svegliarti naturalmente al primo mattino? Potresti sfruttare quel momento?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早朝に自然と目が覚めることはありますか？その瞬間を活かせそうですか？"
