    "No right answers here — reflection is its own reward." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد إجابات صحيحة هنا — التأمل بحد ذاته مكافأة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gibt es keine richtigen Antworten – die Reflexion ist die Belohnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hay respuestas correctas: reflexionar ya es la recompensa."
          }
        },
        "fr" : {
          "stringUnit" : {
