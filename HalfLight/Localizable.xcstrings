        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧게 깬 뒤 아침의 REM 수면으로 돌아가는 것이 MILD의 최적 지점입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
