        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het fragment opschrijven en er meer details uit laten rollen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать фрагмент и дать ему размотать новые детали"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断片を書き、そこから他の細部を引き出させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조각을 적고, 거기서 더 많은 디테일이 풀려 나오게 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下碎片，然后让更多细节从中展开"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب الشظية، ثم دع المزيد من التفاصيل ينفكّ منها"
          }
        }
      }
    },
    "Force yourself to invent the rest": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligarte a inventar el resto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous forcer à inventer le reste"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dich zwingen, den Rest zu erfinden"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costringerti a inventare il resto"
          }
        },
        "pt-BR": {
