    "Is there a recurring fear in your dreams you'd meet differently if you knew it wasn't real?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ثمة خوف متكرّر في أحلامك كنت ستواجهه بشكل مختلف لو علمت أنه غير حقيقي؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es eine wiederkehrende Angst in deinen Träumen, der du anders begegnen würdest, wüsstest du, dass sie nicht real ist?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay un miedo recurrente en tus sueños que enfrentarías distinto si supieras que no es real?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y a-t-il une peur récurrente dans vos rêves que vous affronteriez autrement si vous saviez qu'elle n'est pas réelle ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è una paura ricorrente nei tuoi sogni che affronteresti diversamente se sapessi che non è reale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢の中にくり返し現れる恐れで、現実でないと分かっていれば違う向き合い方をするものはありますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꿈에 반복해서 나오는 두려움 중, 그것이 진짜가 아님을 안다면 다르게 마주할 것이 있나요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is er een terugkerende angst in je dromen die je anders tegemoet zou treden als je wist dat hij niet echt was?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há um medo recorrente em seus sonhos que você enfrentaria de outro jeito se soubesse que não é real?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть ли в ваших снах повторяющийся страх, который вы встретили бы иначе, зная, что он не настоящий?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的梦里是否有某种反复出现的恐惧，若你知道它不是真的，就会以不同方式去面对？"
          }
        }
      }
    },
