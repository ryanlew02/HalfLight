    "A daytime habit carries into dreams, where the test reveals you're dreaming" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادة نهارية تنتقل إلى الأحلام، حيث يكشف الاختبار أنك تحلم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
