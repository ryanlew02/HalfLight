    "You've had a long dry spell. What helps most?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مررت بفترة جفاف طويلة. ما الذي يساعد أكثر؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hattest eine lange Durststrecke. Was hilft am meisten?"
