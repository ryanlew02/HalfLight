            "value" : "Quand devriez-vous sauter la pratique lucide ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando dovresti saltare la pratica lucida?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明晰夢の練習を見送るべきなのはいつ？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자각몽 수련을 건너뛰어야 할 때는 언제일까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
