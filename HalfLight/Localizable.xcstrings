    "No single technique is magic. Stacked together, they become hard to ignore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تقنية واحدة سحر. حين تُكدَّس معًا، تصبح يصعب تجاهلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine einzelne Technik ist Zauberei. Übereinandergeschichtet werden sie schwer zu ignorieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna técnica por sí sola es mágica. Apiladas juntas, se vuelven difíciles de ignorar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune technique seule n'est magique. Empilées ensemble, elles deviennent difficiles à ignorer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna tecnica da sola è magica. Impilate insieme, diventano difficili da ignorare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単独で魔法のような技法はありません。重ね合わせると、無視できない力になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단독으로 마법인 기법은 없습니다. 함께 쌓으면 무시하기 어려워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen enkele techniek is op zichzelf magisch. Op elkaar gestapeld worden ze moeilijk te negeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma técnica isolada é mágica. Empilhadas juntas, ficam difíceis de ignorar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одна техника поодиночке не волшебство. Сложенные вместе, они становятся силой, которую трудно игнорировать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有哪一种技巧单独就是魔法。层层叠加在一起，它们就变得难以忽视。"
          }
        }
      }
    },
