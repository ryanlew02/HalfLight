    },
    "Tonight, run the full combo once: WBTB window, brief wake, then MILD back to sleep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الليلة، نفّذ التركيبة كاملةً مرة واحدة: نافذة WBTB، استيقاظ قصير، ثم MILD عند العودة إلى النوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führ heute Nacht die volle Kombination einmal aus: WBTB-Fenster, kurzes Erwachen, dann MILD beim Wiedereinschlafen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche, ejecuta la combinación completa una vez: ventana WBTB, breve despertar, luego MILD al volver a dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
