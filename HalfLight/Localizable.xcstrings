            "value": "Abre HalfLight y empieza un nuevo sueño con dictado por voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez HalfLight et démarrez un nouveau rêve avec la dictée vocale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne HalfLight und starte einen neuen Traum mit Sprachdiktat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
