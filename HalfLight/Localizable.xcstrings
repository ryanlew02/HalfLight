        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이른 아침에 저절로 깨는 일이 있나요? 그 순간을 활용할 수 있을까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word je soms vanzelf vroeg in de ochtend wakker? Zou je dat moment kunnen benutten?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você às vezes acorda naturalmente de madrugada? Poderia aproveitar esse momento?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бывает, что вы просыпаетесь сами рано утром? Могли бы вы использовать этот момент?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有时会在清晨自然醒来吗？能否利用那一刻？"
