    "This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'operazione è irreversibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا."
          }
        }
      }
    },
    "This dream is shared to the feed for others to see.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sueño se comparte en el feed para que otros lo vean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rêve est partagé dans le fil pour que d'autres le voient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Traum wird im Feed geteilt, damit andere ihn sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sogno è condiviso nel feed perché altri lo vedano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sonho é compartilhado no feed para outros verem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze droom wordt in de feed gedeeld zodat anderen hem kunnen zien."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сон опубликован в ленте — другие могут его видеть."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この夢はフィードで共有され、他の人が見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 꿈은 다른 사람들이 볼 수 있도록 피드에 공유됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个梦境已分享到动态，供他人查看。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مشاركة هذا الحلم في المنشورات ليراه الآخرون."
          }
        }
      }
    },
    "This is how HalfLight greets you on the Home screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así te saluda HalfLight en la pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ainsi que HalfLight vous accueille sur l'écran d'accueil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So begrüßt dich HalfLight auf dem Startbildschirm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È così che HalfLight ti accoglie nella schermata Home."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É assim que o HalfLight te cumprimenta na tela inicial."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo begroet HalfLight je op het beginscherm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так HalfLight приветствует вас на главном экране."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面でHalfLightがこのようにあなたを迎えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면에서 HalfLight가 이렇게 인사합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是 HalfLight 在主页问候你的方式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يرحّب بك HalfLight في الشاشة الرئيسية."
          }
        }
      }
    },
    "This permanently deletes your account and all dreams backed up to it. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu cuenta y todos los sueños respaldados en ella. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte et tous les rêves qui y sont sauvegardés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht deinen Account und alle darin gesicherten Träume dauerhaft. Das kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente il tuo account e tutti i sogni di cui hai fatto il backup. L'operazione è irreversibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta e todos os sonhos com backup nela. Isso não pode ser desfeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden je account en alle daarin geback-upte dromen permanent verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно удалит вашу учётную запись и все сохранённые в ней сны. Отменить нельзя."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとそこにバックアップされたすべての夢を完全に削除します。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 거기에 백업된 모든 꿈을 영구 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除你的账户及其中备份的所有梦境。此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
