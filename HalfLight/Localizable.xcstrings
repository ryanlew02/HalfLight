    "Commit fully to the method you pick. Half-belief gives you half a door." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التزم تمامًا بالطريقة التي تختارها. نصف الإيمان يمنحك نصف باب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekenn dich voll zur gewählten Methode. Halber Glaube gibt dir eine halbe Tür."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprométete por completo con el método que elijas. Media creencia te da media puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engagez-vous pleinement dans la méthode choisie. Une demi-croyance vous donne une demi-porte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impegnati del tutto nel metodo che scegli. Mezza fede ti dà mezza porta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ方法に全力で身を委ねましょう。半信半疑では、半分の扉しか得られません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 방법에 온전히 전념하세요. 어중간한 믿음은 절반의 문만 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind je volledig aan de gekozen methode. Halve overtuiging geeft je een halve deur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprometa-se por completo com o método que escolher. Meia crença te dá meia porta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью отдайтесь выбранному методу. Полувера даёт половину двери."
          }
        },
