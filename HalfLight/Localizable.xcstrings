          }
        }
      }
    },
    "Payment is charged to your Apple ID. Subscriptions renew automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel in your App Store account settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se cargará a tu Apple ID. Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes del final del período. Gestiona o cancela en los ajustes de tu cuenta de App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de votre identifiant Apple. Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période. Gérez ou annulez dans les réglages de votre compte App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung erfolgt über deine Apple-ID. Abos verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Periodenende gekündigt werden. Verwalte oder kündige in den Einstellungen deines App-Store-Kontos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo Apple ID. Gli abbonamenti si rinnovano automaticamente se non vengono annullati almeno 24 ore prima della fine del periodo. Gestiscili o annullali nelle impostazioni dell'account App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado no seu Apple ID. As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período. Gerencie ou cancele nas configurações da sua conta da App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling wordt in rekening gebracht via je Apple ID. Abonnementen worden automatisch verlengd tenzij ze minstens 24 uur voor het einde van de periode worden opgezegd. Beheer of zeg op in de instellingen van je App Store-account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с вашего Apple ID. Подписки продлеваются автоматически, если не отменить их минимум за 24 часа до окончания периода. Управляйте или отменяйте в настройках учётной записи App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いはApple IDに請求されます。期間終了の24時間前までに解約しない限り、サブスクリプションは自動更新されます。App Storeアカウント設定で管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 Apple ID로 청구됩니다. 기간 종료 최소 24시간 전에 취소하지 않으면 구독이 자동 갱신됩니다. App Store 계정 설정에서 관리하거나 취소하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用将记入你的 Apple ID。除非在当前周期结束前至少 24 小时取消，否则订阅将自动续订。可在 App Store 账户设置中管理或取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخصم الدفع من معرّف Apple الخاص بك. تتجدد الاشتراكات تلقائيًا ما لم تُلغَ قبل 24 ساعة على الأقل من نهاية المدة. يمكنك الإدارة أو الإلغاء من إعدادات حساب App Store."
          }
        }
      }
    },
    "Permanently deletes your account and every dream backed up to it. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente tu cuenta y todos los sueños respaldados en ella. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement votre compte et tous les rêves qui y sont sauvegardés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht deinen Account und alle darin gesicherten Träume dauerhaft. Das kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente il tuo account e tutti i sogni di cui hai fatto il backup. L'operazione è irreversibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente sua conta e todos os sonhos com backup nela. Isso não pode ser desfeito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert je account en alle daarin geback-upte dromen permanent. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет вашу учётную запись и все сохранённые в ней сны. Это нельзя отменить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとそこにバックアップされたすべての夢を完全に削除します。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 거기에 백업된 모든 꿈을 영구적으로 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除你的账户及其中备份的所有梦境。此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف حسابك وكل الأحلام المنسوخة احتياطيًا فيه نهائيًا. لا يمكن التراجع عن هذا."
          }
        }
      }
    },
