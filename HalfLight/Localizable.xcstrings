    "Give up — you're one of the people who can't" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استسلم — أنت من الأشخاص الذين لا يستطيعون"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib auf – du gehörst zu denen, die es nicht können"
