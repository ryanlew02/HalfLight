        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは夢の地理を曲げる術を学びました。夢の風景はすべて、あなたが旅するためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 꿈의 지리를 휘는 법을 배웠습니다. 꿈 풍경 전체가 당신이 누빌 곳입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geleerd de geografie van de droom te buigen. Het hele droomlandschap is van jou om te bereizen."
