    "Each level costs more XP than the last — the deeper you go, the longer the climb.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivel cuesta más XP que el anterior: cuanto más avanzas, más larga es la subida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque niveau coûte plus d'XP que le précédent — plus vous avancez, plus l'ascension est longue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Level kostet mehr XP als das letzte – je tiefer du gehst, desto länger der Aufstieg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni livello costa più XP del precedente: più vai a fondo, più lunga è la salita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nível custa mais XP que o anterior — quanto mais fundo você vai, mais longa é a subida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk niveau kost meer XP dan het vorige — hoe dieper je gaat, hoe langer de klim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый уровень стоит больше XP, чем предыдущий, — чем глубже, тем дольше подъём."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルが上がるほど必要なXPは増えます — 進むほど道のりは長くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨이 오를수록 더 많은 XP가 필요합니다 — 깊이 갈수록 여정은 길어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一级所需的 XP 都比上一级多——越深入，攀登越漫长。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مستوى يتطلب نقاط خبرة أكثر من سابقه — كلما تعمّقت، طال الصعود."
          }
        }
      }
    },
