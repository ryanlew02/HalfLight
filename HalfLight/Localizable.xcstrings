        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你经历了长长的枯水期。什么最有帮助？"
          }
        }
      }
    },
    "You've learned MILD's secret timing. Practice it near morning and watch it bloom." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعلّمت توقيت MILD السري. مارسه قرب الصباح وراقبه يزدهر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast MILDs geheimes Timing gelernt. Übe es nahe dem Morgen und sieh zu, wie es aufblüht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has aprendido el momento secreto de MILD. Practícalo cerca de la mañana y míralo florecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
