        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 숨은 함정을 찾았습니다. 그것을 아는 것이 더 오래 머무는 첫걸음입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de verborgen valstrik gevonden. Die kennen is de eerste stap om langer te blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você encontrou a armadilha escondida. Conhecê-la é o primeiro passo para permanecer mais tempo."
