            "value" : "Apertar os olhos e se concentrar com força"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прищуриться и сильно сосредоточиться"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
