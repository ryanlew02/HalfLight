        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 꿈의 해상도를 높이는 법을 배웠습니다. 이제 현실에는 경쟁자가 생겼습니다."
          }
        },
        "nl" : {
