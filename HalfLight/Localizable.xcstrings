    "Rubbing hands is the dreamer's classic for a reason — it works fast and anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرك اليدين هو كلاسيكية الحالم لسبب وجيه — يعمل بسرعة وفي أي مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händereiben ist der Klassiker des Träumers, und das aus gutem Grund – es wirkt schnell und überall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frotarse las manos es el clásico del soñador por algo: funciona rápido y en cualquier lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se frotter les mains est le classique du rêveur pour une bonne raison — ça marche vite et partout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfregare le mani è il classico del sognatore per un motivo — funziona in fretta e ovunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手をこすり合わせるのが夢見手の定番なのには理由があります——速く、どこでも効くからです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손 비비기가 몽자의 고전인 데는 이유가 있습니다 — 빠르고, 어디서나 통하니까요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handen wrijven is dé klassieker van de dromer, en niet voor niets — het werkt snel en overal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esfregar as mãos é o clássico do sonhador por um motivo — funciona rápido e em qualquer lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тереть ладони — классика сновидца не зря: работает быстро и где угодно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搓手是梦者的经典招式，自有道理——它见效快，且随处可用。"
          }
        }
      }
    },
