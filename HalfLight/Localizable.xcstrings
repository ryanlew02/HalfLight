    "Active sensory engagement anchors you firmly inside the dream." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشغال الحواس النشط يثبّتك بإحكام داخل الحلم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver Sinneseinsatz verankert dich fest im Traum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La activación sensorial activa te ancla con firmeza dentro del sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'engagement sensoriel actif vous ancre fermement dans le rêve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ingaggio sensoriale attivo ti ancora saldamente dentro il sogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能動的に感覚を使うことが、あなたを夢の中にしっかり錨づけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감각을 능동적으로 쓰는 것이 당신을 꿈 속에 단단히 닻 내립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actieve zintuiglijke betrokkenheid verankert je stevig in de droom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O engajamento sensorial ativo te ancora firmemente dentro do sonho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активное вовлечение чувств прочно укореняет вас внутри сна."
