    "Returning to morning REM after a short waking is MILD's sweet spot." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العودة إلى نوم REM الصباحي بعد استيقاظ قصير هي بقعة MILD الذهبية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rückkehr in den morgendlichen REM-Schlaf nach einem kurzen Erwachen ist MILDs Idealmoment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver al sueño REM matutino tras un breve despertar es el punto óptimo de MILD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenir au sommeil REM du matin après un bref réveil est le moment idéal de MILD."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornare al sonno REM mattutino dopo un breve risveglio è il punto ideale di MILD."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い目覚めのあと朝のREM睡眠へ戻ることが、MILDの最適な瞬間です。"
