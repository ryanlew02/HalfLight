    "Subscribe to unlock AI dream analysis, auto-tags, and AI titles.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete para desbloquear el análisis de sueños con IA, las etiquetas automáticas y los títulos con IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous pour débloquer l'analyse de rêve par IA, les tags automatiques et les titres IA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere, um KI-Traumanalyse, Auto-Tags und KI-Titel freizuschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati per sbloccare l'analisi dei sogni con IA, i tag automatici e i titoli IA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine para desbloquear a análise de sonhos por IA, as tags automáticas e os títulos por IA."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer om AI-droomanalyse, automatische tags en AI-titels te ontgrendelen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпишитесь, чтобы открыть ИИ-анализ снов, авто-теги и ИИ-заголовки."
