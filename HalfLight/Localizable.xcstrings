        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明晰の時間は短い——明確な目標がそれを焦点づけ、豊かにする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자각의 시간은 짧다 — 분명한 목표가 그것을 집중시키고 풍요롭게 한다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucide tijd is kort — een duidelijk doel focust en verrijkt die"
