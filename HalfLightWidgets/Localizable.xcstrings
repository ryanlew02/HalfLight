    "Did you dream last night? Capture it before it fades." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل حلمت الليلة الماضية؟ سجّله قبل أن يتلاشى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du letzte Nacht geträumt? Halte es fest, bevor es verblasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Soñaste anoche? Captúralo antes de que se desvanezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avez-vous rêvé cette nuit ? Notez-le avant qu'il ne s'efface."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai sognato stanotte? Catturalo prima che svanisca."
          }
