        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어젯밤 꿈을 꾸셨나요? 사라지기 전에 기록하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je vannacht gedroomd? Leg het vast voordat het vervaagt."
