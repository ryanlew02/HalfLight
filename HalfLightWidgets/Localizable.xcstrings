    "A dream a day keeps the haze away. Log today's." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلم كل يوم يبدّد الضباب. دوّن حلم اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Traum am Tag vertreibt den Nebel. Trag den von heute ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sueño al día mantiene la bruma a raya. Registra el de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rêve par jour éloigne le brouillard. Notez celui d'aujourd'hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sogno al giorno tiene lontana la nebbia. Registra quello di oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日ひとつの夢が霧を晴らします。今日の夢を記録しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 꿈 하나면 안개가 걷힙니다. 오늘의 꿈을 기록하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag een droom houdt de mist weg. Noteer die van vandaag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sonho por dia mantém a névoa longe. Registre o de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один сон в день разгоняет туман. Запишите сегодняшний."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一日一梦，雾散云开。记下今天的吧。"
          }
        }
      }
    },
