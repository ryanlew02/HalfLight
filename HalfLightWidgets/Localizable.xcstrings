    "Notice your dream signs — the recurring oddities." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لاحظ علامات أحلامك — الغرائب المتكررة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf deine Traumzeichen – die wiederkehrenden Merkwürdigkeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fíjate en tus señales oníricas: las rarezas que se repiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repérez vos signes oniriques — les étrangetés récurrentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota i tuoi segni onirici — le stranezze ricorrenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢のサインに気づきましょう — 繰り返し現れる奇妙さに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꿈 신호를 알아차리세요 — 반복해서 나타나는 이상한 것들."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op je droomtekens — de terugkerende vreemdheden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
